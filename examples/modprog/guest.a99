*======================================================================
* guest.a99 - a MODULE PROGRAM: this module is all that is on the disk; the
* cartridge it runs under supplies the kernel (docs/MODPROG.md).  Build it with
*   python3 tools/skmodprog.py guest.a99 --target build/workbench -o GUEST
* and start it from the cartridge's RUN PROGRAM FILE.
*
* It shows it is running and using the kernel: a frame counter that ticks
* every frame (kernel variable FRAME, printed with HEX4), a count of the keys
* typed (DECW), the keys echoed (PUTC), and FCTN = quits (QUITF).
*======================================================================
       COPY  "kernel.equ"
       COPY "macros.a99"      .enter, .leave, .push, .pop, .callmod

ATEXT  EQU  (RTEXT*16+RBG)*256        text on the page background
ABAR   EQU  (RBARFG*16+RBARBG)*256    the status bar's colours

CURPOS EQU  APPRAM+0                   where the next typed character goes
NKEYS  EQU  APPRAM+2                   how many keys have been typed

       AORG >C000
       DATA  INIT,TICK,REDRAW,0

INIT   .enter
       CLR  @NKEYS
       BL   @REDRAW
       .leave
       RT

REDRAW .enter
       LI   R1,ATEXT
       BL   @CLS                       every cell a space in the text colours
       CLR  R0                         the top row as a bar
       LI   R1,ABAR
       LI   R2,COLS
       BL   @FILLA
       LI   R0,1
       LI   R1,TITLE
       LI   R2,ABAR
       BL   @PUTS
       LI   R0,2*COLS+2
       LI   R1,LINE1
       LI   R2,ATEXT
       BL   @PUTS
       LI   R0,3*COLS+2
       LI   R1,LINE2
       LI   R2,ATEXT
       BL   @PUTS
       LI   R0,5*COLS+2
       LI   R1,FRMS
       LI   R2,ATEXT
       BL   @PUTS
       LI   R0,6*COLS+2
       LI   R1,KEYS
       LI   R2,ATEXT
       BL   @PUTS
       LI   R0,8*COLS+2
       LI   R1,TYPE
       LI   R2,ATEXT
       BL   @PUTS
       LI   R0,10*COLS+2
       MOV  R0,@CURPOS
       .leave
       RT

TICK   .enter
       MOV  R0,R0
       JEQ  TK2                        no key
       CI   R0,KQUIT*256               FCTN = ?
       JNE  TK1
       SETO @QUITF                     ask the kernel to quit
       JMP  TK9
TK1    CI   R0,>2000                   a printable character (space to ~)?
       JL   TK2
       CI   R0,>7F00
       JHE  TK2
       MOV  R0,R1                      echo it
       MOV  @CURPOS,R0
       LI   R2,ATEXT
       BL   @PUTC
       INC  @CURPOS
       INC  @NKEYS
TK2    LI   R0,5*COLS+10               the frame counter, in hex
       MOV  @FRAME,R1
       LI   R2,ATEXT
       BL   @HEX4
       LI   R0,6*COLS+14               the keys typed, in decimal
       MOV  @NKEYS,R1
       LI   R2,ATEXT
       BL   @DECW
TK9    .leave
       RT

TITLE  STRI 'Module program on disk'
LINE1  STRI 'This program is a module on a disk;'
LINE2  STRI 'the cartridge supplied the kernel.'
FRMS   STRI 'Frames: >'
KEYS   STRI 'Keys typed: '
TYPE   STRI 'Type something; FCTN = quits.'
       EVEN
