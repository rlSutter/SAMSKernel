*======================================================================
* view.a99 - the disk browser's second module: a text file viewer.
*
* The browser switched here with GOMOD, handing over the file's number
* (INIT's R1).  The file is read a record at a time into SAMS pages taken
* from the page pool (PINIT, PALLOC), 51 lines of 80 bytes to a page, and
* drawn from there through slot B (MAPE).  UP and DOWN scroll, FCTN 5
* (BEGIN) goes to the top, FCTN 9 (BACK) returns to the browser, FCTN =
* quits.  Up to 8 pages: 408 lines.
*
* Shows GOMOD's argument, the pool, paging data through slot B, and
* reading a file with the file service.
*======================================================================
* THE SIMPLEST MULTI-PAGE PROGRAM.  A text file is read into SAMS pages and
* shown from there.  If you are learning how to use SAMS memory, read this
* file first and the workbench editor (examples/workbench/ed.a99 and the
* guide's appendix C) second: this is the same idea with the least machinery.
*
* The idea: 51 lines of 80 bytes (4,080 bytes) fit in one 4K page.  Line n
* lives in page n / 51 of the file, at offset (n mod 51) * 80.  The program
* keeps a table, VPAGES, of the pool page that holds each block of 51 lines.
* To read or show line n it divides n by 51 (DIV: quotient the page index,
* remainder the place), looks the page number up in VPAGES, maps that page
* into the window at >E000 (MAPE) and finds the line at >E000 + place * 80.
* It takes pages from the pool one at a time as lines arrive (PALLOC), at most
* MAXPG of them: 408 lines.  The editor does exactly this, adding a table of
* line order so that lines can be inserted.
       COPY "kernel.equ"
       COPY "macros.a99"
       COPY "shared.a99"

VROWS  EQU  26                 text rows on the screen (rows 2-27)
MAXPG  EQU  8

       AORG >C000
       DATA VWINIT,VWTICK,VWDRAW,0

* VWINIT - switched to: R1 = the file's number in the browser's list.
* Build its name, load it, draw.
VWINIT .enter
       SLA  R1,4               its entry: ENTS + n * 16
       AI   R1,ENTS
       LI   R2,VNAME+1         DSK1. then the name
       LI   R3,SDSK+1
       LI   R4,5
VI1    MOVB *R3+,*R2+
       DEC  R4
       JNE  VI1
       MOVB *R1+,R4            the name's length
       SWPB R4
       MOV  R4,R5
       AI   R5,5               the whole name's length
       SWPB R5
       MOVB R5,@VNAME
VI2    MOVB *R1+,*R2+
       DEC  R4
       JNE  VI2
       CLR  @NLINES
       CLR  @TOPLN
       BL   @VLOAD
       BL   @VWDRAW
       .leave
       RT

* VLOAD - read the file into pool pages.  The pool is the pages from
* PGFREE up (the build leaves them to us), MAXPG of them.
VLOAD  .enter
       LI   R0,PGFREE
       LI   R1,PGFREE+MAXPG
       BL   @PINIT
       LI   R2,VNAME
       LI   R0,FIN+FVAR        DIS/VAR 80, input
       LI   R1,80
       BL   @FOPEN
       MOV  R0,R0
       JNE  VL9                (an unreadable file shows as empty)
VL1    LI   R1,LINBUF          the next record
       BL   @FREAD
       MOV  R0,R0
       JNE  VL8                the end (5) or an error
       MOV  R2,@VWORK          its length
       BL   @VPUT              keep it as line NLINES
       MOV  R0,R0
       JEQ  VL8                the pool is empty: stop
       BL   @KIDLE             (keys typed meanwhile are kept)
       JMP  VL1
VL8    BL   @FCLOSE
VL9    .leave
       RT

* VPUT - store LINBUF (VWORK = its length) as line NLINES, 80 bytes
* padded with spaces.  R0 = 1 stored, 0 no room.  Takes a new pool page
* at each 51st line.
VPUT   .enter
       MOV  @NLINES,R1         line / 51: the page index; remainder: the slot
       CLR  R0
       LI   R3,LPP
       DIV  R3,R0              R0:R1 / 51: R0 = quotient, R1 = remainder
       MOV  R0,@VWORK+2        the page index
       MOV  R1,@VWORK+4        the slot
       MOV  R1,R1              slot 0: a new page
       JNE  VP2
       MOV  @VWORK+2,R0
       CI   R0,MAXPG
       JHE  VP0
       BL   @PALLOC
       MOV  R0,R0
       JEQ  VP0                none left
       MOV  @VWORK+2,R1
       SLA  R1,1
       MOV  R0,@VPAGES(R1)
VP2    MOV  @VWORK+2,R1        map the page
       SLA  R1,1
       MOV  @VPAGES(R1),R0
       BL   @MAPE
       MOV  @VWORK+4,R0        the slot's address: >E000 + slot * 80
       LI   R1,80
       MPY  R1,R0              (R0:R1 = slot * 80)
       AI   R1,>E000
       MOV  R1,R3              fill the slot with spaces
       LI   R2,80
       LI   R4,>2000
VP3    MOVB R4,*R3+
       DEC  R2
       JNE  VP3
       MOV  @VWORK,R2          copy the record into it
       CI   R2,80
       JLE  VP4
       LI   R2,80
VP4    MOV  R2,R2
       JEQ  VP5
       LI   R3,LINBUF
VP4A   MOVB *R3+,*R1+
       DEC  R2
       JNE  VP4A
VP5    INC  @NLINES
       LI   R0,1
       JMP  VP9
VP0    CLR  R0
VP9    .leave
       RT

* VWDRAW - the screen: the title bar, the visible lines, the footer.
VWDRAW .enter
       LI   R1,ANORM
       BL   @CLS
       CLR  R0
       LI   R1,ABAR
       LI   R2,COLS
       BL   @FILLA
       LI   R0,1
       LI   R1,VNAME
       LI   R2,ABAR
       BL   @PUTS
       LI   R0,29*COLS+2
       LI   R1,SKEYS
       LI   R2,AMARK
       BL   @PUTS
       LI   R0,29*COLS+58      "Line n of m"
       LI   R1,SLINE
       LI   R2,AMARK
       BL   @PUTS
       LI   R0,29*COLS+63
       MOV  R0,@VWORK+6
       MOV  @TOPLN,R1
       INC  R1
       LI   R2,AMARK
       BL   @DECW              R3 = the digits
       A    R3,@VWORK+6
       INC  @VWORK+6
       MOV  @VWORK+6,R0
       LI   R1,SOF
       LI   R2,AMARK
       BL   @PUTS
       MOV  @VWORK+6,R0
       AI   R0,3
       MOV  @NLINES,R1
       LI   R2,AMARK
       BL   @DECW
       CLR  R9                 the rows
VD1    MOV  R9,R0              line TOPLN + row
       A    @TOPLN,R0
       C    R0,@NLINES
       JHE  VD9
       BL   @VLINE
       INC  R9
       CI   R9,VROWS
       JL   VD1
VD9    .leave
       RT

* VLINE - line R0 to screen row 2 + R9.
VLINE  .enter
       MOV  R0,R1              its page and slot: R0:R1 / 51
       CLR  R0
       LI   R3,LPP
       DIV  R3,R0              R0 = page index, R1 = slot
       MOV  R1,@VWORK+4
       MOV  R0,R4
       SLA  R4,1
       MOV  @VPAGES(R4),R0
       BL   @MAPE
       MOV  @VWORK+4,R0
       LI   R1,80
       MPY  R1,R0              R1 = slot * 80
       AI   R1,>E000
       MOV  R9,R0              screen row 2 + R9
       AI   R0,2
       LI   R2,COLS
       MPY  R0,R2              R3 = row * 80
       MOV  R3,R0
       LI   R2,80
       BL   @VMBW              (R1 is the source)
       .leave
       RT

* VWTICK - a key.
VWTICK .enter
       MOV  R0,R0
       JEQ  VT9
       CI   R0,KQUIT*256
       JNE  VT1
       SETO @QUITF
       JMP  VT9
VT1    CI   R0,KBACK*256       BACK: to the browser
       JNE  VT2
       MOV  @PREVPG,R0
       CLR  R1
       BL   @GOMOD
       JMP  VT9
VT2    CI   R0,KUP*256
       JNE  VT3
       MOV  @TOPLN,R1
       JEQ  VT9
       DEC  @TOPLN
       JMP  VT8
VT3    CI   R0,KDOWN*256
       JNE  VT4
       MOV  @TOPLN,R1
       AI   R1,VROWS
       C    R1,@NLINES
       JHE  VT9
       INC  @TOPLN
       JMP  VT8
VT4    CI   R0,KBEGIN*256
       JNE  VT9
       CLR  @TOPLN
VT8    BL   @VWDRAW
VT9    .leave
       RT

SDSK   STRI 'DSK1.'
SKEYS  STRI 'UP DOWN scroll   BEGIN top   BACK return   FCTN = quit'
SLINE  STRI 'Line'
SOF    STRI 'of'
       EVEN
