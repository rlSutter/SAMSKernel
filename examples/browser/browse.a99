*======================================================================
* browse.a99 - the disk browser's first module: the catalog of DSK1 as
* a list.  UP and DOWN move, ENTER views a text file (the viewer module,
* through GOMOD with the file's number as its argument), FCTN = quits.
*
* Shows the file service (FOPEN of "DSK1.", FREAD, FCNUM, FCLOSE) and
* module switching.
*======================================================================
* TWO MODULES AND A DISK CATALOG.  This is a program in two modules
* (browse.a99 and view.a99, each at >C000 in its own SAMS pages; shared.a99
* holds what they both include).  Only one module is mapped at a time.  They
* cooperate in two ways: through variables at fixed addresses in APPRAM, which
* stay put when the module changes (shared.a99 lists them), and through GOMOD,
* which switches modules and hands the new one a number (its INIT's R1).  The
* browser sends the viewer the file's number; the viewer returns with GOMOD
* PREVPG ('whoever ran before me').
*
* The catalog trick.  There is no 'list the files' call: the TI disk system
* makes the catalog look like a file.  Open the device name alone ('DSK1.') as
* INTERNAL, FIXED, record length 38 and read it like any file.  The first
* record describes the disk (its name, its size in sectors, the free sectors);
* each following record describes one file (its name, a type code, its size)
* and an empty name ends the list.  The numbers inside the records are stored
* in the console's floating-point radix-100 form, which FCNUM turns into an
* integer.
       COPY "kernel.equ"
       COPY "macros.a99"
       COPY "shared.a99"

       AORG >C000
       DATA BRINIT,BRTICK,BRDRAW,0

* BRINIT - switched to: read the catalog, then draw.
BRINIT .enter
       CLR  @MSGNO
       MOVB @DEVSTR,@DEVSTR    the device: 'DSK1.' the first time only (the
       JNE  BI0                digit stays what a key made it across a trip
       LI   R1,SDSK            through the viewer)
       LI   R2,DEVSTR
       LI   R3,6
BI00   MOVB *R1+,*R2+
       DEC  R3
       JNE  BI00
BI0    BL   @BRLOAD
       MOV  @SEL,R0            keep the selection inside the list
       C    R0,@NFILES
       JL   BI1
       CLR  @SEL
       CLR  @TOP
BI1    BL   @BRSCR
       BL   @BRDRAW
       .leave
       RT

* BRLOAD - the frame and 'Reading ...' first (so that a controller that is slow,
* or answers with nothing, is seen to be being asked), then the catalog.
BRLOAD .enter
       BL   @BRDRAW
       LI   R0,27*COLS+2
       LI   R1,SREAD
       LI   R2,AMARK
       BL   @PUTS
       BL   @BCAT
       .leave
       RT

* BCAT - read the catalog of the device in DEVSTR into ENTS.  It is opened
* with record length 0 (the DSR's own; the HFDC refuses 38) and, if the DSR
* refuses that, or opens it and then reads nothing, again with 38 (some
* controllers want it said).  A failure shows its error in the message line.
BCAT   .enter
       CLR  @RETRY
BCT    CLR  @NFILES
       CLR  @DISKSZ
       CLR  @DISKFR
       CLR  R0
       MOVB R0,@DNAME
       LI   R2,DEVSTR          the device alone: the catalog
       LI   R0,FIN+FINTL       INTERNAL, input
       CLR  R1                 length 0: the DSR's own
       MOV  @RETRY,R3
       JEQ  BCL
       LI   R1,38              the second try says 38
BCL    BL   @FOPEN
       MOV  R0,R0
       JEQ  BC0
       AI   R0,100             could not open: 100 + the DSR's error
       MOV  R0,@MSGNO
       MOV  @RETRY,R0
       JNE  BC9
       INC  @RETRY
       CLR  @MSGNO
       JMP  BCT
BC0    LI   R1,RECBUF          the first record describes the disk
       BL   @FREAD
       MOV  R0,R0
       JEQ  BC0X
       AI   R0,100             not read: 100 + the error (5: end of file)
       MOV  R0,@MSGNO
       JMP  BC0Y
BC0X   MOV  R2,R2              a record of no length is no answer
       JNE  BC0Z
       LI   R0,105
       MOV  R0,@MSGNO
BC0Y   BL   @FCLOSE
       MOV  @RETRY,R0
       JNE  BC9                the second try failed too: the message stays
       INC  @RETRY
       CLR  @MSGNO
       JMP  BCT
BC0Z   LI   R1,RECBUF          its name ...
       LI   R2,DNAME
       LI   R3,11
BC0A   MOVB *R1+,*R2+
       DEC  R3
       JNE  BC0A
       LI   R1,RECBUF          ... its size ...
       LI   R2,1
       BL   @FCNUM
       MOV  R0,@DISKSZ
       LI   R1,RECBUF          ... and the sectors free
       LI   R2,2
       BL   @FCNUM
       MOV  R0,@DISKFR
BC1    LI   R1,RECBUF          each file
       BL   @FREAD
       MOV  R0,R0
       JNE  BCC
       MOVB @RECBUF,R0         an empty name ends the catalog
       JEQ  BCC
       MOV  @NFILES,R0
       CI   R0,MAXF
       JHE  BCC
       SLA  R0,4               the entry: ENTS + n * 16
       AI   R0,ENTS
       MOV  R0,@EPTR
       LI   R1,RECBUF          the name, 10 characters at most
       CLR  R3
       MOVB *R1,R3
       SWPB R3
       CI   R3,10
       JLE  BC2
       LI   R3,10
BC2    MOV  @EPTR,R2
       MOV  R3,R4
       SWPB R4
       MOVB R4,*R2+            its length
       LI   R1,RECBUF+1
BC3    MOVB *R1+,*R2+
       DEC  R3
       JNE  BC3
       LI   R1,RECBUF          the type (negative: protected)
       CLR  R2
       BL   @FCNUM
       ABS  R0
       MOV  @EPTR,R2
       MOV  R0,@12(R2)
       LI   R1,RECBUF          the size
       LI   R2,1
       BL   @FCNUM
       MOV  @EPTR,R2
       MOV  R0,@14(R2)
       INC  @NFILES
       JMP  BC1
BCC    BL   @FCLOSE
BC9    .leave
       RT

* BRDRAW - the whole screen.
BRDRAW .enter
       LI   R1,ANORM
       BL   @CLS
       CLR  R0
       LI   R1,ABAR
       LI   R2,COLS
       BL   @FILLA
       LI   R0,1
       LI   R1,STITLE
       LI   R2,ABAR
       BL   @PUTS
       LI   R0,17              the device
       LI   R1,DEVSTR
       LI   R2,ABAR
       BL   @PUTS
       LI   R0,2*COLS+2        the disk: name, size, free
       LI   R1,DNAME
       LI   R2,AMARK
       BL   @PUTS
       LI   R0,2*COLS+16
       MOV  @DISKSZ,R1
       LI   R2,AMARK
       BL   @DECW
       LI   R0,2*COLS+21
       LI   R1,SSECT
       LI   R2,AMARK
       BL   @PUTS
       LI   R0,2*COLS+34
       MOV  @DISKFR,R1
       LI   R2,AMARK
       BL   @DECW
       LI   R0,2*COLS+39
       LI   R1,SFREE
       LI   R2,AMARK
       BL   @PUTS
       LI   R0,4*COLS+2        the column heads
       LI   R1,SHEAD
       LI   R2,AMARK
       BL   @PUTS
       MOV  @NFILES,R1         which file of how many
       JEQ  BD0
       MOV  @SEL,R1
       INC  R1
       LI   R0,4*COLS+54
       LI   R2,AMARK
       BL   @DECW
       LI   R0,4*COLS+58
       LI   R1,SOF
       LI   R2,AMARK
       BL   @PUTS
       LI   R0,4*COLS+61
       MOV  @NFILES,R1
       LI   R2,AMARK
       BL   @DECW
BD0    MOV  @TOP,R9            the files from TOP (R9 is kept by the rows)
BD1    C    R9,@NFILES
       JHE  BD9
       MOV  R9,R0
       S    @TOP,R0
       CI   R0,VIS
       JHE  BD9
       MOV  R9,R0
       BL   @BRROW
       INC  R9
       JMP  BD1
BD9    BL   @BRMSG
       LI   R0,29*COLS+2
       LI   R1,SKEYS
       LI   R2,AMARK
       BL   @PUTS
       .leave
       RT

* BRROW - file R0's row: name, type, size; highlighted if selected.
BRROW  .enter
       MOV  R0,R9
       LI   R4,ANORM           the attribute: selected or not
       C    R0,@SEL
       JNE  BW1
       LI   R4,ASEL
BW1    MOV  R4,@VWORK          (kept: PUTS changes R0-R7)
       MOV  R9,R0
       SLA  R0,4
       AI   R0,ENTS
       MOV  R0,@VWORK+2        the entry
       MOV  R9,R1              the row: 5 + n - TOP
       S    @TOP,R1
       AI   R1,5
       LI   R2,COLS
       MPY  R1,R2              R3 = the row's first cell
       MOV  R3,@VWORK+4
       MOV  R3,R0              the whole row in the attribute
       MOV  @VWORK,R1
       LI   R2,COLS
       BL   @FILLA
       MOV  @VWORK+4,R0        name
       AI   R0,2
       MOV  @VWORK+2,R1
       MOV  @VWORK,R2
       BL   @PUTS
       MOV  @VWORK+2,R1        type: its name from the table
       MOV  @12(R1),R1
       CI   R1,6
       JLE  BW2
       CLR  R1
BW2    SLA  R1,1
       AI   R1,STYPES
       MOV  *R1,R1
       MOV  @VWORK+4,R0
       AI   R0,16
       MOV  @VWORK,R2
       BL   @PUTS
       MOV  @VWORK+2,R1        size
       MOV  @14(R1),R1
       MOV  @VWORK+4,R0
       AI   R0,28
       MOV  @VWORK,R2
       BL   @DECW
       .leave
       RT

* BRMSG - the message line (row 27), if there is one.
BRMSG  .enter
       LI   R0,27*COLS+2
       LI   R1,ANORM
       LI   R2,70
       BL   @FILLA
       MOV  @MSGNO,R1
       JEQ  BM9
       LI   R2,SNOTXT          1: not a text file
       CI   R1,1
       JEQ  BM1
       LI   R2,SNOCAT          the catalog could not be read: 100 + the error
BM1    MOV  R2,R1
       LI   R0,27*COLS+2
       LI   R2,AERR
       BL   @PUTS
       MOV  @MSGNO,R1          a catalog failure: its error's number too
       CI   R1,100
       JL   BM9
       AI   R1,-100
       LI   R0,27*COLS+36
       LI   R2,AERR
       BL   @DECW
BM9    .leave
       RT

* BRTICK - a key.
BRTICK .enter
       MOV  R0,R0
       JEQ  BT9
       CI   R0,KQUIT*256
       JNE  BT1
       SETO @QUITF
       JMP  BT9
BT1    CLR  @MSGNO
       CI   R0,KUP*256
       JNE  BT2
       MOV  @SEL,R1
       JEQ  BT8
       DEC  @SEL
       JMP  BT8
BT2    CI   R0,KDOWN*256
       JNE  BT3
       MOV  @SEL,R1
       INC  R1
       C    R1,@NFILES
       JHE  BT8
       INC  @SEL
       JMP  BT8
BT3    CI   R0,KENTER*256
       JEQ  BT3A
       CI   R0,'1'*256         1-9: that drive
       JL   BT9
       CI   R0,'9'*256
       JH   BT9
       MOVB R0,@DEVSTR+4
       CLR  @SEL
       CLR  @TOP
       BL   @BRLOAD
       JMP  BT8
BT3A   MOV  @NFILES,R1         a file selected?
       JEQ  BT9
       MOV  @SEL,R1            DIS/VAR (type 2) only
       SLA  R1,4
       MOV  @ENTS+12(R1),R2
       CI   R2,2
       JEQ  BT4
       LI   R2,1
       MOV  R2,@MSGNO          1: not a text file
       JMP  BT8
BT4    LI   R0,PG_VIEW         the viewer, with the file's number
       MOV  @SEL,R1
       BL   @GOMOD
       JMP  BT9
BT8    BL   @BRSCR
       BL   @BRDRAW
BT9    .leave
       RT

* BRSCR - TOP so that the selected file is on the screen.
BRSCR  MOV  @SEL,R0
       C    R0,@TOP
       JHE  BS1
       MOV  R0,@TOP            above the screen: it becomes the top
BS1    MOV  @TOP,R1
       AI   R1,VIS
       C    R0,R1
       JL   BS9
       MOV  R0,R1              below it: it becomes the bottom
       AI   R1,1-VIS
       MOV  R1,@TOP
BS9    RT

STITLE STRI ' Disk browser   '
SDSK   STRI 'DSK1.'
SREAD  STRI 'Reading the catalog ...'
SSECT  STRI 'sectors'
SFREE  STRI 'free'
SHEAD  STRI 'Name          Type        Sectors'
SKEYS  STRI 'UP DOWN select   ENTER view   1-9 drive   FCTN = quit'
SNOTXT STRI 'Not a DIS/VAR text file.'
SNOCAT STRI 'The disk could not be read: error'
STQ    STRI '?'
STDF   STRI 'DIS/FIX'
STDV   STRI 'DIS/VAR'
STIF   STRI 'INT/FIX'
STIV   STRI 'INT/VAR'
STPG   STRI 'PROGRAM'
STDIR  STRI 'DIR'
SOF    STRI 'of'
       EVEN
STYPES DATA STQ,STDF,STDV,STIF,STIV,STPG,STDIR
