*======================================================================
* motion.a99 - eight balls bouncing round the screen: sprite motion
* (app.json "motion": true).  The kernel moves the sprites every frame from a
* motion table in the program's RAM; this module sets the table up once and,
* each frame, turns a ball round when it reaches an edge.  FCTN = quits.
*
* The motion table (8 bytes a sprite): Y.y, X.x, dY, dX, each a word of 8.8
* fixed point; the high byte of a position is the sprite attribute table's own
* byte.  Velocities are signed 8.8 dots a frame: >0100 is a dot a frame.
*======================================================================
       COPY "kernel.equ"
       COPY "macros.a99"

NSPR   EQU  8
TAB    EQU  APPRAM                    8 sprites x 8 bytes
* (SPMINI, SPMPUT, SPMVEL use R0-R4: the loop below counts in R6 and R7)
CBUF   EQU  APPRAM+64                 pattern and colour bytes for the table

       AORG >C000
       DATA INIT,TICK,INIT,0

INIT   .enter
       LI   R0,VMGM1                   Graphics I, sprites on
       LI   R1,VOSPR
       BL   @VMODE
       LI   R0,SPTAB                   pattern 0: a ball
       LI   R1,PBALL
       LI   R2,8
       BL   @VMBW
       LI   R0,TAB                     the table, 8 sprites, the SAT
       LI   R1,NSPR
       LI   R2,SATAB
       BL   @SPMINI
       LI   R7,START
       CLR  R6
IN1    MOV  R6,R0                      sprite R6: its start Y and X ...
       MOV  *R7,R1
       MOV  @2(R7),R2
       BL   @SPMPUT
       MOV  R6,R0                      ... and its velocity
       MOV  @4(R7),R1
       MOV  @6(R7),R2
       BL   @SPMVEL
       MOV  R6,R0                      pattern 0, colour 2 + sprite
       SLA  R0,2
       AI   R0,SATAB+2
       MOV  R6,R1
       AI   R1,2
       MOV  R1,@CBUF
       LI   R1,CBUF
       LI   R2,2
       BL   @VMBW
       AI   R7,8
       INC  R6
       CI   R6,NSPR
       JL   IN1
       .leave
       RT

* Each frame: a ball at an edge that is still heading out turns round.
TICK   .enter
       CI   R0,KQUIT*256
       JNE  TK0
       SETO @QUITF
       JMP  TK9
TK0    LI   R3,TAB
       LI   R4,NSPR
TK1    MOVB *R3,R1                     Y in dots
       SRL  R1,8
       MOV  @4(R3),R0                  Y velocity
       CI   R1,176                     at the bottom and going down?
       JL   TK2
       MOV  R0,R0
       JLT  TK3
       NEG  @4(R3)
       JMP  TK3
TK2    CI   R1,10                      at the top and going up?
       JH   TK3
       MOV  R0,R0
       JGT  TK3
       NEG  @4(R3)
TK3    MOVB @2(R3),R1                  X in dots
       SRL  R1,8
       MOV  @6(R3),R0                  X velocity
       CI   R1,240                     at the right and going right?
       JL   TK4
       MOV  R0,R0
       JLT  TK5
       NEG  @6(R3)
       JMP  TK5
TK4    CI   R1,8                       at the left and going left?
       JH   TK5
       MOV  R0,R0
       JGT  TK5
       NEG  @6(R3)
TK5    AI   R3,8
       DEC  R4
       JNE  TK1
TK9    .leave
       RT

PBALL  BYTE >3C,>7E,>FF,>FF,>FF,>FF,>7E,>3C

* Y, X (dots, as the attribute table has them), then Y and X velocity (8.8)
START  DATA 20,30,>0140,>0100
       DATA 50,200,>FF00,>0180
       DATA 80,60,>00C0,>FEC0
       DATA 110,120,>0180,>0080
       DATA 140,220,>FF40,>FF00
       DATA 30,90,>0100,>0200
       DATA 160,40,>FE80,>0140
       DATA 90,150,>0080,>FF80
