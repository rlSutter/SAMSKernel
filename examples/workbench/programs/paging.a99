*======================================================================
* paging.a99 - a program for the workbench's disk: SAMS pages from the
* page pool.  ENTER takes four pages from the pool, writes each page's own
* number into it through slot B (>E000), maps them back one by one to check
* every page kept its own, and puts slot B back as it found it (GETPB and
* SETPB).  FCTN 9 returns to the workbench, FCTN = quits.
*======================================================================
* A SECOND LOOK AT MULTI-PAGE PROGRAMMING, in the smallest form.  This program
* does only what a program that uses SAMS memory has to do: ask the page pool
* for pages, look at each through a window, and put the window back as it
* found it.  The editor (examples/workbench/ed.a99) does the same on a larger
* scale; read this first.
*
* The four steps in TEST: (1) GETPB / SETPB: a window is shared, and whoever
* borrows it must give it back, so the first thing is to record which pages
* slot B holds now; (2) PINIT / PALLOC: the pool hands out page NUMBERS; a
* page is not 'there' until it is mapped; (3) MAPE: put page n in the window
* at >E000: from then on addresses >E000 to >EFFF are that page's 4,096 bytes;
* (4) write something in it, map the next page, and so on; mapping a page back
* shows what it still holds, which is how SAMS memory is used as a larger
* store than the 64K address space.
       COPY "kernel.equ"
       COPY "macros.a99"

ANORM  EQU  (RTEXT*16+RBG)*256
ABAR   EQU  (RBARFG*16+RBARBG)*256
ABOLD  EQU  (RBOLD*16+RBG)*256
AERR   EQU  (RERROR*16+RBG)*256

* These variables are above APPRAM+5760 so that they do not overwrite the
* workbench's own state (the shell, the editor, the assembler) which lives
* below: when a program is run from the workbench it shares APPRAM with them.
* A program built for a cartridge of its own may use APPRAM from offset 0.
* Note the comment on CHK: the file and page routines change R6-R9 (and MAPE
* changes R1-R3), so a loop counter that must survive a call is kept in
* memory, not in a register.
* (free when run from the workbench: see docs/WORKBENCH.md)
WORK   EQU   APPRAM+5760
PGS    EQU  WORK+0             the four pages (words)
GOOD   EQU  WORK+8             pages that kept their number
IDX    EQU  WORK+10            pages allocated
CHK    EQU  WORK+12            the page being checked (memory: not R6-R9)
TMPP   EQU  WORK+14            a page number in hand
* The pool is given every page from POOLP to the end of the card (NPAGES).
* Pages below it are the workbench's own: its code, and the pages the program
* being tested runs from.  The workbench gives up the editor's pages when it
* runs a program, so the whole range above the workbench's own pages is free.
* Calling PINIT again resets the pool completely, so a program that has run
* once starts clean on the next ENTER.
POOLP  EQU  PGFREE+30          the pool starts above the workbench's own pages

       AORG >C000
       DATA INIT,TICK,INIT,0

INIT   .enter
       LI   R1,ANORM
       BL   @CLS
       CLR  R0
       LI   R1,ABAR
       LI   R2,COLS
       BL   @FILLA
       LI   R0,1
       LI   R1,STITLE
       LI   R2,ABAR
       BL   @PUTS
       LI   R0,2*COLS+2
       LI   R1,SCARD
       LI   R2,ANORM
       BL   @PUTS
       LI   R0,2*COLS+16
       MOV  @NPAGES,R1
       LI   R2,ABOLD
       BL   @DECW
       LI   R0,3*COLS+2
       LI   R1,SHELP
       LI   R2,ANORM
       BL   @PUTS
       .leave
       RT

TICK   .enter
       MOV  R0,R9
       JEQ  T9
       CI   R9,KQUIT*256
       JNE  T1
       SETO @QUITF
       JMP  T9
T1     CI   R9,KBACK*256
       JNE  T2
       LI   R0,PG_WB
       CLR  R1
       BL   @GOMOD
       JMP  T9
T2     CI   R9,KENTER*256
       JNE  T9
       BL   @TEST
T9     .leave
       RT

* The loop at TS1 is the whole idiom.  PALLOC returns a page number in R0 (0
* means the pool is empty); keep it (the table PGS); MAPE puts it in the
* window; the first word of the page becomes the page's own number, a pattern
* that makes a wrongly mapped page obvious.  Because MAPE changes R1-R3 the
* index is reloaded from memory afterwards.  The second loop (TS4) maps each
* page again and checks the number is still there: if the pages really are
* separate 4K stores, all four match.
* TEST - four pages from the pool, each filled with its own number, then
* checked.
TEST   .enter
       BL   @GETPB             slot B as it is now: R0, R1 (kept on the stack)
       .push R0
       .push R1
       LI   R0,POOLP
       MOV  @NPAGES,R1
       BL   @PINIT             the pool: every page from POOLP up
       CLR  @IDX
TS1    BL   @PALLOC            R0 = a page (0: none left)
       MOV  R0,R0
       JEQ  TS2
       MOV  R0,@TMPP
       MOV  @IDX,R1
       SLA  R1,1
       MOV  R0,@PGS(R1)        (R1 is changed by MAPE: the index is reloaded)
       MOV  @TMPP,R0
       BL   @MAPE              the page appears at >E000
       MOV  @TMPP,@>E000       and takes its own number as its first word
       INC  @IDX
       MOV  @IDX,R1
       CI   R1,4
       JL   TS1
TS2    CLR  @GOOD
       CLR  @CHK
TS4    MOV  @CHK,R1
       C    R1,@IDX            as many as were allocated
       JHE  TS6
       SLA  R1,1
       MOV  @PGS(R1),R0
       MOV  R0,@TMPP
       BL   @MAPE
       C    @>E000,@TMPP       still its own number?
       JNE  TS5
       INC  @GOOD
TS5    INC  @CHK
       JMP  TS4
TS6    .pop R1
       .pop R0
       BL   @SETPB             slot B back as it was
       BL   @SHOW
       .leave
       RT

* HEX4 is the kernel's routine for four hexadecimal digits; the page numbers
* are shown in hex because the card's pages are numbered from 0 to >FFF.
* SHOW - the page numbers and the verdict.
SHOW   .enter
       LI   R0,5*COLS+2
       LI   R1,SPAGES
       LI   R2,ANORM
       BL   @PUTS
       CLR  R9
SW1    C    R9,@IDX
       JHE  SW2
       MOV  R9,R3
       SLA  R3,1
       MOV  @PGS(R3),R1
       MOV  R9,R0
       SLA  R0,2
       A    R9,R0
       AI   R0,5*COLS+24       five columns a page number
       LI   R2,ABOLD
       BL   @HEX4
       INC  R9
       JMP  SW1
SW2    LI   R0,7*COLS+2
       MOV  @GOOD,R1
       LI   R2,ABOLD
       BL   @DECW
       LI   R0,7*COLS+4
       LI   R1,SOF
       LI   R2,ANORM
       BL   @PUTS
       LI   R0,7*COLS+7
       MOV  @IDX,R1
       LI   R2,ABOLD
       BL   @DECW
       LI   R0,7*COLS+9
       LI   R1,SKEPT
       LI   R2,ANORM
       BL   @PUTS
       MOV  @GOOD,R1
       C    R1,@IDX
       JNE  SW3
       CI   R1,4
       JNE  SW3
       LI   R0,8*COLS+2
       LI   R1,SOK
       LI   R2,ABOLD
       BL   @PUTS
       JMP  SW9
SW3    LI   R0,8*COLS+2
       LI   R1,SBAD
       LI   R2,AERR
       BL   @PUTS
SW9    .leave
       RT

STITLE STRI ' Paging   a program made on the TI'
SCARD  STRI 'Card pages:'
SHELP  STRI 'ENTER: four pool pages, each given its own number   FCTN 9 back'
SPAGES STRI 'Pool pages:'
SOF    STRI 'of'
SKEPT  STRI 'pages kept their own number'
SOK    STRI 'OK'
SBAD   STRI 'FAILED'
       EVEN
