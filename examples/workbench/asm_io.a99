
*----------------------------------------------------------------------
* files and the two passes
*----------------------------------------------------------------------
ATEXT  EQU  (RTEXT*16+RBG)*256

* OPENCUR - open the file at this depth for reading (its name is in
* NAMES).  R0 = 0 or the error.  Uses R0-R9.
OPENCUR .enter
       MOV  @DEPTH,R1
       MOV  R1,R2
       SLA  R2,3
       SLA  R1,4
       A    R1,R2
       AI   R2,NAMES
       LI   R0,FIN+FVAR
       LI   R1,80
       BL   @FOPEN
       .leave
       RT

* ASMFILE - assemble the file whose name is at R2 (length-prefixed), and
* the files it COPYs, in the current pass.  Uses everything.
ASMFILE .enter
       MOV  @DEPTH,R1
       CI   R1,3
       JLE  AF0
       LI   R0,E_FIL
       BL   @ERR
       B    @AF99
AF0    MOV  R1,R3              keep the name at this depth
       SLA  R3,3
       MOV  R1,R4
       SLA  R4,4
       A    R4,R3
       AI   R3,NAMES
       CLR  R4
       MOVB *R2+,R4
       SWPB R4
       CI   R4,23
       JLE  AF0A
       LI   R4,23
AF0A   MOV  R4,R5
       SWPB R5
       MOVB R5,*R3+
AF0B   MOV  R4,R4
       JEQ  AF0C
       MOVB *R2+,*R3+
       DEC  R4
       JMP  AF0B
AF0C   SLA  R1,1
       CLR  @CNTS(R1)
       BL   @OPENCUR
       MOV  R0,R0
       JEQ  AFLP
       LI   R0,E_FIL
       BL   @ERRA
       B    @AF99
AFLP   MOV  @ENDF,@ENDF
       JNE  AFCLS
       LI   R1,LINE
       BL   @FREAD
       MOV  R0,R0
       JNE  AFEOF
       MOV  R2,@LLEN
       LI   R1,LINE
       A    R2,R1
       CLR  R3
       MOVB R3,*R1             end the line with a zero
       MOV  @DEPTH,R1
       SLA  R1,1
       INC  @CNTS(R1)
       MOV  @CNTS(R1),@LNUM
       LI   R8,LINE
       BL   @ASMLINE
       BL   @PROG
       MOV  @COPYF,@COPYF
       JEQ  AFLP
       BL   @FCLOSE            an include: the file is closed, the
       INC  @DEPTH             include is assembled, and this file is
       LI   R2,INCNM           opened again and read up to where it was
       BL   @ASMFILE
       DEC  @DEPTH
       MOV  @DEPTH,R1
       SLA  R1,1
       MOV  @CNTS(R1),@LNUM
       BL   @OPENCUR
       MOV  R0,R0
       JNE  AFCLS
       MOV  @DEPTH,R1
       SLA  R1,1
       MOV  @CNTS(R1),@TMPW+4
AFSKP  MOV  @TMPW+4,@TMPW+4
       JEQ  AFLP
       LI   R1,LINE
       BL   @FREAD
       DEC  @TMPW+4
       JMP  AFSKP
AFEOF  CI   R0,FEEOF
       JEQ  AFCLS
       LI   R0,E_FIL
       BL   @ERR
AFCLS  BL   @FCLOSE
AF99   .leave
       RT

* PROG - "pass n line m" on row 28 every 64 lines.
PROG   .enter
       MOV  @LNUM,R1
       ANDI R1,>003F
       JNE  PRG9
       LI   R0,28*COLS+2
       LI   R1,SPRG
       LI   R2,ATEXT
       BL   @PUTS
       LI   R0,28*COLS+8
       MOV  @PASS,R1
       LI   R2,ATEXT
       BL   @DECW
       LI   R0,28*COLS+15
       MOV  @LNUM,R1
       LI   R2,ATEXT
       BL   @DECW
PRG9   .leave
       RT
SPRG   STRI 'Pass       line'
       EVEN

* PASSIN - the counters at the start of a pass.
PASSIN CLR  @LC
       CLR  @LCSTMT
       CLR  @DEPTH
       CLR  @ENDF
       CLR  @LNUM
       CLR  @UNRES
       RT

* ASMGO - assemble SRCNAME.  R0 = the number of errors; OUTLEN, ORGB and
* OUTBUF hold the image.
ASMGO  .enter
       CLR  @NERR
       CLR  @OUTLEN
       CLR  @ORGSET
       CLR  @ORGB
       LI   R1,OUTBUF
       LI   R2,OUTMAX/2
AG1    CLR  *R1+
       DEC  R2
       JNE  AG1
       BL   @MAPSYM
       LI   R1,SYMBAS
       LI   R2,4000
AG2    CLR  *R1+
       DEC  R2
       JNE  AG2
       LI   R0,1
       MOV  R0,@PASS
       BL   @PASSIN
       LI   R2,SRCNAME
       BL   @ASMFILE
       LI   R0,2
       MOV  R0,@PASS
       BL   @PASSIN
       CLR  @ORGSET
       LI   R2,SRCNAME
       BL   @ASMFILE
       MOV  @NERR,R0
       .leave
       RT

*----------------------------------------------------------------------
* the operations: name (8 characters), opcode, class.  Classes 1-12 are
* instructions (INSTR), 20 and up directives, 40 and up the macros.
*----------------------------------------------------------------------
OPTAB
       TEXT '.CALLMOD'
       DATA >0000,45
       TEXT '.ENTER  '
       DATA >0000,40
       TEXT '.INTSVC '
       DATA >0000,44
       TEXT '.LEAVE  '
