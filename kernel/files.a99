*======================================================================
* files.a99 - the file service: disk (and any other device's) files
* through the console's DSRs, as a PAB and a record at a time.
*
* A program opens a file with FOPEN, reads or writes records with FREAD
* and FWRITE, and closes it with FCLOSE; FDELETE removes a file.  Every
* routine returns R0 = 0 when it worked, else the DSR's error code 1-7
* (the three top bits of the PAB's flag byte: 5 = past the end of the
* file, 7 = file not found) or >FF when no card answers to the device
* name.  Up to FMAXH (3) files can be open at once, each through a handle
* 0-2: FSEL says which handle the other routines act on (it is 0 until a
* program changes it, so a program that never calls FSEL has one file, as
* before).  Each handle has its own PAB in VRAM (the controller tells open
* files apart by their PABs); the record buffer is shared, since a call
* finishes with it.  The disk controller keeps 3 file buffers, so a fourth
* open fails with the DSR's error.  Close a file before FDELETE on its handle.
*
* The names are length-prefixed strings ("DSK1.NOTES", a byte 10 first,
* STRI makes them).  The records are copied between the VRAM buffer and
* the caller's own buffer (up to 255 bytes), so no caller ever touches the
* PABs, VRAM >3600-37BF, or the controller's area from >37D8.
*
* How the DSR is called (the rules the Lantern Coast learned the hard way):
*   - in the GPL workspace (>83E0), R12 the card's CRU base, R13 = >9800,
*     R15 = >8C02, >8356 pointing past the device name's dot, >8354 the
*     name's length, as the console's own DSRLNK does;
*   - the scratchpad >8320->837F it may change is saved and put back, but
*     >8370 (the bottom of the controller's buffers, which it finds through
*     that word) is kept as the controller's power-up left it, or every
*     later access on a real TI controller hangs;
*   - the controller's power-up routine runs once, before its first call;
*   - R6-R9 are changed by a DSR call (callers keep what they need on the
*     stack); the error is read from the PAB's own flag byte, on both
*     returns of the DSR.
* DSR calls take milliseconds to seconds: poll the keyboard between
* records (KIDLE) if the user must not be locked out.
*======================================================================

* WHAT A PAB IS.  The disk system (and any device a DSR card provides) is
* operated through a PERIPHERAL ACCESS BLOCK, a small structure that lives in
* VIDEO memory, not in CPU memory: the console's DSR code reads and writes it
* there.  Its layout: byte 0 the operation (0 open, 1 close, 2 read, 3 write,
* 7 delete), byte 1 the file's mode flags on the way in and the ERROR CODE in
* its top three bits on the way out, bytes 2-3 the address in VRAM of the data
* buffer, byte 4 the record length, byte 5 the count of characters (the length
* actually read or to write), bytes 6-7 the record number, byte 9 the length
* of the file name, and then the name itself ('DSK1.NOTES').  To do anything
* the kernel builds a PAB in its VRAM area (>3700 and up, one per handle),
* sets the scratchpad words the DSR convention asks for (>8354, >8356), and
* calls the DSR; the DSR does the work and
* leaves the answer in the flag byte.
*
* That is why FREAD and FWRITE copy records between VRAM and your buffer: the
* DSR can only read and write the VRAM buffer, so the kernel moves the data in
* and out and you never see the PAB.  The error numbers are the disk system's
* own (the top three bits of the flag byte, values 0 to 7); the kernel returns
* them unchanged, or >FF when no card answers to the device name.
* FSEL - choose the file handle (0-2) the other file routines act on: R0 = the
* handle.  R0 = 0, or >FF if there is no such handle (and the choice stays).
* Each handle's file stays open while you use the others.  Leaf.  Uses R0.
FSEL   CI   R0,FMAXH
       JHE  FSL9
       MOV  R0,@FSELH
       CLR  R0
       RT
FSL9   LI   R0,>00FF
       RT

* FPADR - R0 = the VRAM address of the selected handle's PAB.  Leaf.
FPADR  MOV  @FSELH,R0
       SLA  R0,6               64 bytes a PAB
       AI   R0,FPABV
       RT

* FOPEN - open the file named by R2 (a length-prefixed string).
*   R0 = flags in the high byte (add FIN/FOUT/FUPDT/FAPP, FVAR/FFIXED,
*        FINTL/FDISP: FIN+FVAR is >1400, a DIS/VAR file for input),
*   R1 = the record length (0 lets an input file say it; for fixed
*        files the length they were made with).
* R0 = 0 or the error.  A name that is only a device and dot ("DSK1.")
* opens the disk's catalog: FIN+FINTL+FFIXED with record length 38
* (see FCNUM).  Uses R0-R9 and the DSR's.
FOPEN  CLR  R3
FPABOP .enter
       MOV  R2,@FNMP           the name
       MOVB *R2,R4             too long for the PAB (53 characters at most)?
       SRL  R4,8
       CI   R4,53
       JH   FOBAD
       LI   R2,FPAB
       MOVB R3,*R2+            opcode (R3's high byte: 0 OPEN, 7 DELETE)
       MOVB R0,*R2+            flags
       LI   R4,FBUFV
       MOVB R4,*R2+            buffer address, high byte first
       SWPB R4
       MOVB R4,*R2+
       SWPB R1
       MOVB R1,*R2+            record length
       CLR  R1                 (zeros)
       MOVB R1,*R2+            character count
       MOVB R1,*R2+            record number
       MOVB R1,*R2+
       MOVB R1,*R2+            screen offset
FONM   MOV  @FNMP,R1           name length and name
       CLR  R3
       MOVB *R1,R3             its length ...
       SWPB R3
       INC  R3                 ... plus the length byte
FO1    MOVB *R1+,*R2+          into the PAB
       DEC  R3
       JNE  FO1
       MOV  R2,R4              (its end)
       BL   @FPADR             the selected handle's PAB in VRAM
       LI   R1,FPAB
       MOV  R4,R2
       AI   R2,-FPAB           its length
       BL   @VMBW              copied there
       BL   @FCALL             call the DSR
FOOUT  MOV  R0,@FERR
       .leave
       RT
FOBAD  LI   R0,>00FF           a name that cannot be used: no such device
       JMP  FOOUT

* FREAD - read the next record into the buffer at R1 (up to 255 bytes).
* R0 = 0, 5 at the end of the file, or the error; R2 = the record's
* length (also in FLEN).  Uses R0-R9.
FREAD  .enter
       MOV  R1,@FNMP           (the destination, kept in FNMP meanwhile)
       BL   @FPADR
       LI   R1,>0200           opcode 2: READ
       BL   @VSBW
       BL   @FCALL
       CLR  R2
       MOV  R0,R0
       JNE  FR9
       BL   @FPADR
       AI   R0,5               the PAB's character count
       BL   @VRAD
       CLR  R2
       MOVB @VDPRD,R2
       SWPB R2
       MOV  R2,@FLEN
       JEQ  FR8
       LI   R0,FBUFV
       MOV  @FNMP,R1           the destination
       BL   @VMBR              (VMBR keeps R2? it counts R2 down: reload)
       MOV  @FLEN,R2
FR8    CLR  R0
FR9    MOV  R0,@FERR
       .leave
       RT

* FWRITE - write R2 bytes (0-255) from the buffer at R1 as a record.
* R0 = 0 or the error.  Uses R0-R9.
FWRITE .enter
       MOV  R2,@FLEN           (kept)
       LI   R0,FBUFV           the record buffer in VRAM
       MOV  R2,R2              nothing to copy?
       JEQ  FW1
       BL   @VMBW              the bytes there (R1 is the source)
FW1    BL   @FPADR
       AI   R0,5               the PAB's character count
       MOV  @FLEN,R1
       SWPB R1                 (a byte)
       BL   @VSBW
       BL   @FPADR
       LI   R1,>0300           opcode 3: WRITE
       BL   @VSBW
       BL   @FCALL
       MOV  R0,@FERR
       .leave
       RT

* FCLOSE - close the file.  R0 = 0 or the error.  Uses R0-R9.
FCLOSE .enter
       BL   @FPADR
       LI   R1,>0100           opcode 1: CLOSE
       BL   @VSBW
       BL   @FCALL
       MOV  R0,@FERR
       .leave
       RT

* FDELETE - delete the file named by R2 (DSR opcode 7).  R0 = 0 or the
* error.  Uses R0-R9.
FDELETE LI  R3,>0700           opcode 7: DELETE
       CLR  R0
       LI   R1,80
       B    @FPABOP

* FLOAD - load the PROGRAM file named by R2 (a length-prefixed string,
* 'DSK1.NAME') into VRAM from the address R0, at most R1 bytes: the DSR's LOAD
* (opcode 5), on the selected handle's PAB.  R0 = 0 or the error.  The file's
* bytes go straight to VRAM, so the address must be clear of what the screen
* uses in the current mode, of this file service's own record buffer and PAB
* (>3600-37D7) and of the controller's buffers (>37D8 up): in Text 80 the
* free run is >2000-35FF (5,632 bytes) without enhanced colour and sprites,
* >2000-2FFF with sprites.  A 6K picture does not fit beside file calls.
* FSAVE - save R1 bytes of VRAM from the address R0 as the PROGRAM file R2
* names: the DSR's SAVE (opcode 6).  R0 = 0 or the error.  Neither touches a
* file another handle has open.  Uses R0-R9 and the DSR's.
FLOAD  LI   R3,>0500
       JMP  FPGM
FSAVE  LI   R3,>0600
FPGM   .enter
       MOV  R2,@FNMP
       MOVB *R2,R4             a name too long for the PAB?
       SRL  R4,8
       CI   R4,53
       JH   FOBAD
       LI   R2,FPAB
       MOVB R3,*R2+            the opcode
       CLR  R4
       MOVB R4,*R2+            flags
       MOVB R0,*R2+            the VRAM address, high byte first
       SWPB R0
       MOVB R0,*R2+
       MOVB R4,*R2+            record length
       MOVB R4,*R2+            character count
       MOVB R1,*R2+            the byte count (the 'record number' field)
       SWPB R1
       MOVB R1,*R2+
       MOVB R4,*R2+            screen offset
       B    @FONM

* FCALL - call the DSR for the PAB at FPABV: the previous error cleared,
* the scratchpad it uses kept and put back, >8356 at the name length.
* R0 = 0, the error, or >FF.  After the call it polls the keyboard and steps the
* music (KIDLE) if a frame passed meanwhile: a DSR runs with interrupts off, so
* without this the keys typed and the song playing during a long job (an
* assembly, a load, a save) would be lost.  Uses R0-R9.
FCALL  .enter
       BL   @FPADR
       INC  R0                 the previous call's error bits (the top three
       MOV  R0,@FPFLG          of the flag byte) cleared first: a DSR that
       BL   @VSBR              succeeds may leave them as they were, and a
       ANDI R1,>1F00           later call would report that old error
       MOV  @FPFLG,R0
       BL   @VSBW
       LI   R1,>8320           >8320->837F -> FHOT
       LI   R2,FHOT
       LI   R3,48              48 words
FC1    MOV  *R1+,*R2+          kept
       DEC  R3
       JNE  FC1
       BL   @FPADR
       AI   R0,9               the PAB's name length byte
       MOV  R0,@>8356          where DSRLNK finds the name
       BL   @DSRLNK            find the device and call it
       MOV  R0,R5              (the result)
       LI   R1,FHOT            put the scratchpad back
       LI   R2,>8320
       LI   R3,48
FC2    MOV  *R1+,*R2+
       DEC  R3
       JNE  FC2
       LI   R0,>0100           (and the frame counter's increment: a DSR
       MOVB R0,@TMRINC         works in the GPL workspace, whose R14 it is;
*                              TI's controller was not seen to change it, but
*                              VSYNC would wait for ever if one did)
       MOV  @FD70,@>8370       (but >8370 as the controller left it: the
       MOV  R5,R0              bottom of its buffers, which it finds through
*                              it; restoring the old value hangs every later
*                              access on a real TI controller)
       .push R0
       BL   @KIDLE             a frame passed during the call?  take the keys
       .pop R0                 (the keyboard and the music: see KIDLE)
       .leave
       RT

* FCNUM - number n of a catalog record: R1 = the record's address (as
* FREAD left it after opening "DSK1." as FIN+FINTL, record length 38),
* R2 = n, counting the numbers after the name from 0 (a file's type is 0, its
* size 1, its record length 2). R0 = the integer. Record 0 is the disk (name,
* 0, its size in
* sectors, sectors free); every other record is a file (name, type,
* size in sectors, record length; a type is 1 DIS/FIX, 2 DIS/VAR, 3 INT/FIX,
* 4 INT/VAR, 5 program, negative for a protected file) and an empty name
* ends the catalog.  Numbers are 8-byte radix-100 floats after the name;
* this reads small integers only (under 10,000), as catalogs hold.  The
* name is the length-prefixed string at the record's start.  Uses R0-R5.
* Leaf.
* R2:R3 = n * 9 (each number is a length byte and 8 bytes)
FCNUM  MPY   @FC9,R2
       CLR  R2                 past the name: 1 + its length
       MOVB *R1,R2
       SWPB R2
       INC  R2
       A    R2,R3
       A    R1,R3
       INC  R3                 past the number's own length byte
       MOV  R3,R5              the number's bytes
       MOVB *R5+,R2            the first word: exponent and first digit pair
       SWPB R2
       MOVB *R5+,R2
       SWPB R2
       CLR  R4                 R4: negative?
       MOV  R2,R2
       JEQ  FCN8               zero
       JGT  FCN1
       NEG  R2                 negative: negate the word
       SETO R4
FCN1   MOV  R2,R0
       SRL  R0,8               the exponent byte
       ANDI R2,>00FF           the first digit pair
       CI   R0,>40
       JEQ  FCN2               exponent >40: the first pair alone
       MPY  @FC100,R2          R3 = first pair * 100
       CLR  R0
       MOVB *R5,R0             plus the second pair
       SWPB R0
       A    R3,R0
       JMP  FCN3
FCN2   MOV  R2,R0
FCN3   MOV  R4,R4
       JEQ  FCN9
       NEG  R0
FCN9   RT
FCN8   CLR  R0
       RT
FC9    DATA 9
FC100  DATA 100

* DSRLNK - find the device named in the PAB and call its DSR (from The
* Lantern Coast).  >8356 -> the PAB's name length byte.  R0 = 0, the DSR's
* error 1-7, or >FF (no card has that device).  The console's own DSRLNK
* is not used: it needs the GPL environment the kernel does not keep.
DSRLNK .enter
       MOV  R10,@FSR10
       MOV  @FDPWR,R0          every card powered up yet?  (once)
       JNE  DLSTRT
       SETO @FDPWR
       BL   @DSRPWR
DLSTRT MOV  @>8356,R0
       BL   @VRAD
       MOVB @VDPRD,R3          full name length
       SRL  R3,8
       JNE  $+6                (skip the next if not empty)
       B    @DLNONE
       LI   R4,FNAMB           the device name's buffer
       CLR  R5                 device name length
DKL1   MOVB @VDPRD,R6          a character of the name
       CB   R6,@DOT            the '.' ends the device?
       JEQ  DKL2
       MOVB R6,*R4+            keep it
       INC  R5                 one more
       DEC  R3                 the full length left
       JNE  DKL1
DKL2   MOV  R5,R5              a device name at all?
       JNE  $+6
       B    @DLNONE
       MOV  R5,@>8354          its length, for the DSR
       MOV  R5,R0              past the device and its '.'
       INC  R0
       A    R0,@>8356          where the DSR finds the rest of the name
       LI   R12,>0F00          before the first card
DLNEXT MOV  R12,R12            a card switched on?
       JEQ  DLN1
       SBZ  0                  switch it off
DLN1   AI   R12,>0100          the next card's CRU base
       CLR  @>83D0             (no card yet)
       CI   R12,>2000          past the last (>1F00)?
       JNE  $+6
       JMP  DLNONE
       MOV  R12,@>83D0         this card's CRU base, for the DSR
       SBO  0                  its ROM on
       LI   R2,>4000
       CB   *R2,@HAA           a valid header (>AA)?
       JNE  DLNEXT
       LI   R2,>4008           its device list
DLGO2  MOV  *R2,R2             the next entry
       JEQ  DLNEXT             the list's end?
       MOV  R2,@>83D2          (kept, for the DSR)
       INCT R2
       MOV  *R2+,R9            its routine's address
       MOVB *R2+,R6            the name's length
       SRL  R6,8
       C    R6,R5              the same length?
       JNE  DLGO1
       LI   R6,FNAMB           compare the names
       MOV  R5,R7
DLNM1  CB   *R6+,*R2+
       JNE  DLGO1
       DEC  R7
       JNE  DLNM1
       MOV  R12,@FDCRU         the card holding it
DLCALL MOV  R9,@FDENT          the device's routine
       LWPI GPLWS              the GPL workspace
       BL   @DLGPL             call it
       JMP  DLER0              (no return: an error)
       LWPI WS                 a return past the JMP: found and run
       SETO R5                 R5: it ran
       JMP  DLRD
DLER0  LWPI WS
       JMP  DLERR
DLGO1  MOV  @>83D2,R2          the next entry
       JMP  DLGO2
DLERR  CLR  R5                 R5: not run
DLRD   SBZ  0                  the card's ROM off
       BL   @FPADR
       INC  R0                 the PAB's flag byte
       BL   @VRAD
       MOVB @VDPRD,R0          the PAB's flag byte
       SRL  R0,13              its error bits (top three)
       JNE  DLOUT              an error: return it
       MOV  R5,R5              ran?
       JNE  DLOUT
       INC  R0                 no error but not run: 1
       JMP  DLOUT
DLNONE LI   R0,>00FF           >FF: no such device
DLOUT  MOV  @FSR10,R10         our stack back
       .leave
       RT
* DSRPWR - run the power-up routines of every card, as the console does when
* it starts (the kernel has reset VRAM since, so the controller's buffers at
* the top of VRAM must be made again): VRAM's top is set to >3FFF, then each
* card in CRU order (>1000 up) with a valid header has its power-up list run,
* and the bottom the buffers reached is kept (FD70).  A TI controller at >1100
* is powered whichever device is used first.  A TIPI is NOT powered here: its
* power-up routine (its DSR's own: >1000 and >1200 do nothing else) pulses the
* Pi's RESET line and returns, which the console already did at start-up and
* which only disturbs the Pi's session now (js99er's TIPI closes its websocket
* and holds the CPU until it reconnects); only a TIPI at >1100, standing in for
* the disk controller, has buffers to make, and that one is powered.  A TIPI is
* recognised by its first device name, TIPI.  Uses R0-R3, R12.
DSRPWR .enter
       MOV  @>8354,@FD54       what a power-up may change, kept
       MOV  @>8356,@FD56
       MOV  @>83D0,@FDD0
       MOV  @>83D2,@FDD2
       LI   R0,>3FFF           VRAM's top, before the power-ups
       MOV  R0,@>8370
       LI   R12,>0F00
PW1    MOV  R12,R12
       JEQ  PW2
       SBZ  0                  the last card off
PW2    AI   R12,>0100
       CI   R12,>2000
       JEQ  PWEND
       MOV  R12,@FDCRU
       SBO  0                  this card's ROM on
       LI   R2,>4000
       CB   *R2,@HAA           a valid header?
       JNE  PW1
       CI   R12,>1100          a card at >1100 (the disk's place): power it
       JEQ  PW2B
       MOV  @>4008,R3          a TIPI?  its first device is named TIPI
       JEQ  PW2B
       C    @4(R3),@TPIN
       JNE  PW2B
       C    @6(R3),@TPIN+2
       JNE  PW2B
       CB   @8(R3),@TPIN+4
       JEQ  PW1                yes: its power-up only resets the Pi
PW2B   MOV  @>4004,R2          its power-up list
PW3    MOV  R2,R2
       JEQ  PW1                (the list's end: the next card)
       MOV  R2,@FDPW2
       INCT R2
       MOV  *R2,@FDENT         the routine
       LWPI GPLWS              the GPL workspace, as the console's DSRLNK
       BL   @DLGPL             call it
       JMP  PW4                (the return after it)
PW4    LWPI WS
       MOV  @FDCRU,R12         the card again, its ROM on
       SBO  0
       MOV  @FDPW2,R2
       MOV  *R2,R2             the next entry of the list
       JMP  PW3
PWEND  MOV  @>8370,@FD70       the bottom of the controller's buffers
       MOV  @FD54,@>8354       put back what a power-up may change
       MOV  @FD56,@>8356
       MOV  @FDD0,@>83D0
       MOV  @FDD2,@>83D2
       .leave
       RT
* a device list entry's name: its length byte, then TIPI
TPIN   DATA >0454,>4950,>4900

* DLGPL - (entered after LWPI GPLWS, so R9 R12 R13 R15 here are the GPL
* workspace's) call the DSR entry in FDENT as the console's GPL would:
* R12 = the ROM's CRU base, R13 = >9800 (GROM read), R15 = >8C02 (VDP
* address).  The DSR returns to R11+2 when it handled the call, R11 if not.
DLGPL  MOV  @FDCRU,R12
       LI   R13,>9800
       LI   R15,>8C02
       MOV  @FDENT,R9
       B    *R9
HAA    BYTE >AA
DOT    BYTE '.'
       EVEN

*----------------------------------------------------------------------
* the clock: TIPI's PI.CLOCK
*----------------------------------------------------------------------
* CLKGET - read TIPI's clock (the device PI.CLOCK, one record
* "w,mm/dd/yy,HH:MM:SS":
* the form of the Corcomp clock) into the words DTDOW DTMON DTDAY DTYEAR (two
* digits) DTHOUR DTMIN DTSEC (0 if the record has no seconds).  R0 = 0 if it
* worked; else the DSR's error (>FF: there is no such device, no TIPI) or 1 (a
* record too short), and the words are 0.  It uses file handle 2 for a moment
* and puts the selected handle back: do not call it while handle 2 holds an
* open file of yours.  It is slow on a real TIPI (it asks the Pi).  Uses R0-R9.
CLKGET .enter
       LI   R1,DTDOW
       LI   R2,7
CG0    CLR  *R1+
       DEC  R2
       JNE  CG0
       MOV  @FSELH,R0
       .push R0                the caller's handle, kept
       LI   R0,2
       BL   @FSEL
       LI   R2,CLKNM
       LI   R0,FIN+FVAR
       CLR  R1                 the record length: the device's own
       BL   @FOPEN
       MOV  R0,R0
       JNE  CG8                no clock: its error
       AI   R10,-80            a buffer on the stack
       MOV  R10,R1
       BL   @FREAD             R0 = 0 or an error; R2 = the record's length
       MOV  R0,R0
       JNE  CG7
       MOV  R2,R6
       CI   R6,17              "w,mm/dd/yy,HH:MM" at least
       JL   CG6
       MOV  R10,R1
       MOVB *R1+,R0            the day of the week
       SRL  R0,8
       AI   R0,-48
       MOV  R0,@DTDOW
       INC  R1                 ','
       BL   @CK2D
       MOV  R0,@DTMON
       INC  R1                 '/'
       BL   @CK2D
       MOV  R0,@DTDAY
       INC  R1
       BL   @CK2D
       MOV  R0,@DTYEAR
       INC  R1                 ','
       BL   @CK2D
       MOV  R0,@DTHOUR
       INC  R1                 ':'
       BL   @CK2D
       MOV  R0,@DTMIN
       CI   R6,19
       JL   CG5
       INC  R1                 ':'
       BL   @CK2D
       MOV  R0,@DTSEC
CG5    CLR  R0
       JMP  CG7
CG6    LI   R0,1
       LI   R1,DTDOW           (nothing usable: the words stay 0)
       LI   R2,7
CG6A   CLR  *R1+
       DEC  R2
       JNE  CG6A
CG7    AI   R10,80
       .push R0
       BL   @FCLOSE
       .pop R0
CG8    .pop R3
       MOV  R3,@FSELH
       .leave
       RT
CLKNM  STRI 'PI.CLOCK'
       EVEN

* CK2D - the two decimal digits at R1 into R0, R1 past them.  Leaf.  Uses R0-R2.
CK2D   MOVB *R1+,R0
       SRL  R0,8
       AI   R0,-48
       MOV  R0,R2
       SLA  R0,3
       SLA  R2,1
       A    R2,R0              tens * 10
       MOVB *R1+,R2
       SRL  R2,8
       AI   R2,-48
       A    R2,R0
       RT

*----------------------------------------------------------------------
* relative records, the catalog, whether a file exists
*----------------------------------------------------------------------
* FRN - make R3 the record number of the selected handle's PAB (what a
* RELATIVE file's next FREAD or FWRITE addresses).  Uses R0-R2.
FRN    .enter
       MOV  R3,@FPAB           the two bytes, high byte first (the PAB staging
       BL   @FPADR             area is free between calls)
       AI   R0,6               the PAB's record number
       LI   R1,FPAB
       LI   R2,2
       BL   @VMBW
       .leave
       RT

* FRREAD - read record number R3 (0 up) of a RELATIVE file into the buffer at
* R1.  Open the file with FREL + FFIXED (or FINTL) + a mode and the record
* length; then every FRREAD and FRWRITE names the record it wants, in any
* order.  R0 = 0 or the error; R2 = the record's length.  Uses R0-R9.
FRREAD .enter
       MOV  R1,@FRBUF
       BL   @FRN
       MOV  @FRBUF,R1
       BL   @FREAD
       .leave
       RT

* FRWRITE - write R2 bytes from the buffer at R1 as record number R3 of a
* RELATIVE file (see FRREAD).  R0 = 0 or the error.  Uses R0-R9.
FRWRITE .enter
       MOV  R1,@FRBUF
       MOV  R2,@FRLEN
       BL   @FRN
       MOV  @FRBUF,R1
       MOV  @FRLEN,R2
       BL   @FWRITE
       .leave
       RT

* FCATOP - open the catalog of the device named by R2 (a length-prefixed
* device alone: 'DSK1.') on the selected handle and read its first record, the
* disk's own (FCNUM 1 of it is the size in sectors, 2 the sectors free), into
* the buffer at R1 (at least 150 bytes: TI's controller fills 38, the Myarc
* HFDC up to 146).  R0 = 0 or the error.  Then call FCATNX with the
* same buffer until it answers FCEND.  Uses R0-R9.
FCATOP .enter
       MOV  R1,@FCRB
       LI   R0,FIN+FINTL       INTERNAL, input
* record length 0: the DSR's own (38; the Myarc HFDC
       CLR   R1
*                              refuses an explicit 38 and takes 0)
       BL   @FOPEN
       MOV  R0,R0
       JNE  FCO9
       MOV  @FCRB,R1
       BL   @FREAD
FCO9   .leave
       RT

* FCATNX - the next file of the catalog opened by FCATOP: R1 = the same 38-byte
* buffer, R2 = a CE_SIZE-byte entry to fill (CE_NAME, CE_TYPE, CE_SECT,
* CE_RLEN, the numbers decoded).  R0 = 0 for a file, FCEND when there are no
* more (the catalog is then closed), or the error.  Uses R0-R9.
FCATNX .enter
       MOV  R1,@FCRB
       MOV  R2,@FCEA
       BL   @FREAD
       MOV  R0,R0
       JEQ  FCN1X
       CI   R0,FEEOF           the end of the file: the end of the catalog
       JNE  FCNX9
       LI   R0,FCEND
       JMP  FCNX9
FCN1X  MOV  @FCRB,R1
       MOVB *R1,R0             an empty name ends the catalog too
       JNE  FCN2X
       BL   @FCLOSE
       LI   R0,FCEND
       JMP  FCNX9
FCN2X  MOV  @FCEA,R2           the name, at most 10 characters
       CLR  R3
       MOVB *R1,R3
       SWPB R3
       CI   R3,10
       JLE  FCN3X
       LI   R3,10
FCN3X  MOV  R3,R4
       SWPB R4
       MOVB R4,*R2+            its length byte
       MOV  @FCRB,R1
       INC  R1
FCN4X  MOV  R3,R3
       JEQ  FCN5X
       MOVB *R1+,*R2+
       DEC  R3
       JMP  FCN4X
* the three numbers after the name (FCNUM counts from 0)
FCN5X  MOV   @FCRB,R1
       CLR  R2
       BL   @FCNUM
       MOV  @FCEA,R2
       MOV  R0,@CE_TYPE(R2)
       MOV  @FCRB,R1
       LI   R2,1
       BL   @FCNUM
       MOV  @FCEA,R2
       MOV  R0,@CE_SECT(R2)
       MOV  @FCRB,R1
       LI   R2,2
       BL   @FCNUM
       MOV  @FCEA,R2
       MOV  R0,@CE_RLEN(R2)
       CLR  R0
FCNX9  .leave
       RT

* FSYNC - make everything written so far safe on the disk, keeping the file
* open and its place.  TI's controller keeps a file's size and its last sector
* in its own buffers until the file is closed, so records written since the
* last close are lost if the power goes (or the program crashes): FSYNC closes
* the
* selected handle and opens it again.  What can be reopened where it was:
*   an OUTPUT or APPEND file (sequential): reopened for APPEND, so the next
*   record goes on the end, as before;
*   a RELATIVE file (FREL): reopened for UPDATE; the next record is whichever
*   record number the next FRREAD / FRWRITE names;
*   an INPUT file has nothing to flush: R0 = 0 and nothing is done;
*   a sequential UPDATE file cannot be put back at its record: R0 = FNOPL and
*   the file is left open as it was.
* R0 = 0, FNOPL, or the error of the close or the open.  The record length and
* the file's type are those of the first open.  Uses R0-R9.
FSYNC  .enter
       BL   @FPADR
       INC  R0
       BL   @VSBR              R1 = the flag byte (in the high byte)
       SRL  R1,8
       MOV  R1,@FRBUF          the flags, kept
       MOV  R1,R2
       ANDI R2,>0006           the mode: 0 update, 2 output, 4 input, 6 append
       CI   R2,>0004
       JEQ  FSY0               an input file: nothing to flush
       MOV  @FRBUF,R3
       ANDI R3,>0001           a relative file?
       JNE  FSY1
       MOV  R2,R2
       JNE  FSY1               a sequential output or append file
       LI   R0,FNOPL           a sequential update file: the place is lost
       JMP  FSY9
FSY0   CLR  R0
       JMP  FSY9
FSY1   BL   @FCLOSE
       MOV  R0,R0
       JNE  FSY9
* the flags of the new open: the file's kind kept ...
       MOV   @FRBUF,R1
       ANDI R1,>0019
       MOV  @FRBUF,R3
       ANDI R3,>0001
       JNE  FSY2               a relative file: UPDATE (mode 0)
       ORI  R1,>0006           else APPEND
FSY2   SWPB R1
       BL   @FPADR
       INC  R0
       BL   @VSBW              ... and put in the PAB
       CLR  @FPAB              the character count, record number and screen
       CLR  @FPAB+2            offset: zero again
       BL   @FPADR
       AI   R0,5
       LI   R1,FPAB
       LI   R2,4
       BL   @VMBW
       BL   @FPADR             opcode 0: OPEN
       CLR  R1
       BL   @VSBW
       BL   @FCALL
       MOV  R0,@FERR
FSY9   .leave
       RT

* FEXIST - is the file named by R2 ('DSK1.NAME') on the device?  R0 = 0 if it
* is, FENOFI (7) if it is not, >FF for no such device, else the DSR's error.
* It asks the DSR for the file's STATUS (opcode 9) and looks at bit 7 of the
* answer, which is set for a file that does not exist: opening cannot tell the
* cases apart, because TI's controller answers error 2 for a missing file in
* every mode and for a file of the wrong kind alike.  A device that does not
* answer STATUS (an error other than >FF) is asked through its catalog instead
* (FEXCAT).  It uses file handle 2 for a moment, because the call overwrites a
* PAB (keep that handle free), and puts the selected handle back.  Uses R0-R9.
FEXIST .enter
       .push R2
       MOV  @FSELH,R0
       .push R0
       LI   R0,2
       BL   @FSEL
       LI   R3,>0900           opcode 9: STATUS
       CLR  R0
       CLR  R1
       MOV  @2(R10),R2         the name
       BL   @FPABOP
       MOV  R0,R0
       JNE  FX1
       BL   @FPADR             the status byte comes back in the PAB's byte 8
       AI   R0,8
       BL   @VRAD
       MOVB @VDPRD,R1
       ANDI R1,>8000           bit 7: no such file
       LI   R0,FENOFI
       MOV  R1,R1
       JNE  FX9
       CLR  R0
       JMP  FX9
FX1    CI   R0,>00FF           no such device: said
       JEQ  FX9
       MOV  @2(R10),R2         any other error: STATUS is not understood there
       BL   @FEXCAT
FX9    .pop R1
       MOV  R1,@FSELH
       .pop R2
       .leave
       RT

* FEXCAT - is the file named by R2 ('DSK1.NAME') on the disk, found by reading
* the catalog (FCATOP, FCATNX)? R0 = 0 if it is, FENOFI (7) if it is not, else
* the
* error (>FF: no such device or no dot in the name; or the catalog of that
* device
* cannot be read).  FEXIST uses it for a device that does not answer STATUS.  It
* uses file handle 2 for a moment (keep it free) and puts the selected handle
* back.  Uses R0-R9.  It needs 220 bytes of the 256-byte stack (the Myarc HFDC
* writes 146 bytes per catalog record): called from code that has used more
* than 36 bytes of it, it answers >FF rather than overrun it.
FEXCAT .enter
* the frame below takes 192 bytes of the 256-byte stack and the calls under it
* about 28 more: with less room than that, say 'cannot be read' (>FF)
       CI   R10,APPTOP+220
       JHE  FEX00
       LI   R0,>00FF
       .leave
       RT
FEX00  MOV  R2,@FEXN
       MOV  @FSELH,R0
       .push R0
       LI   R0,2
       BL   @FSEL
* a frame on the stack: the catalog record (160 bytes from R10: the HFDC
       AI    R10,-192
* writes up to 146), the entry (R10+160), the device (R10+180)
       MOV  @FEXN,R1           the device: the name up to and including the dot
       MOVB *R1+,R3
       SRL  R3,8
       MOV  R10,R4
       AI   R4,181             (the length byte goes in first)
       CLR  R5
FE1    MOV  R3,R3
       JEQ  FEBAD              no dot: no such device
       MOVB *R1+,R0
       MOVB R0,*R4+
       INC  R5
       DEC  R3
       CI   R5,11
       JH   FEBAD
       CB   R0,@FEDOT
       JNE  FE1
       MOV  R1,@FEXN           (the file's own name follows the dot)
       MOV  R3,@FRLEN          its length
       MOV  R10,R4
       AI   R4,180
       SWPB R5
       MOVB R5,*R4             the device's length byte
       MOV  R10,R1             FCATOP: the record buffer ...
       MOV  R4,R2              ... and the device name
       BL   @FCATOP
       MOV  R0,R0
       JNE  FE9
FE2    MOV  R10,R1
       MOV  R10,R2
       AI   R2,160
       BL   @FCATNX
       MOV  R0,R0
       JEQ  FE3
       CI   R0,FCEND
       JNE  FE9
       LI   R0,FENOFI          not in the catalog
       JMP  FE9
FE3    MOV  R10,R1             the entry's name against the one asked for
       AI   R1,160
       MOVB *R1+,R3
       SRL  R3,8
       C    R3,@FRLEN
       JNE  FE2
       MOV  @FEXN,R2
FE4    MOV  R3,R3
       JEQ  FE5                every character the same: it is there
       MOVB *R1+,R0
       MOVB *R2+,R4
       CB   R0,R4
       JNE  FE2
       DEC  R3
       JMP  FE4
FE5    CLR  R0
       JMP  FE9
FEBAD  LI   R0,>00FF
FE9    AI   R10,192
       .push R0
       BL   @FCLOSE            (it answers an error if the catalog ended)
       .pop R0
       .pop R1
       MOV  R1,@FSELH
       .leave
       RT
FEDOT  BYTE '.'
       EVEN
