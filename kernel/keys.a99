*======================================================================
* keys.a99 - keyboard: matrix scan, ALPHA LOCK, chords, auto-repeat,
* and a 64-key buffer
*
* The main loop calls KPOLL once a frame (after VSYNC): it scans, decodes
* the chord held, and puts a code in the buffer on a new press and on each
* repeat (after 24 frames held, then every 4: 400 ms, then 15 a second, as
* TI-Writer's keys repeat).  Modules take codes with KEYGET.  Long jobs
* may poll too (KIDLE, KPFR), but only between VDP transfers: a key
* rewrites VR1.  Codes are listed in kdefs.a99 and docs/HARDWARE.md; the
* four chord tables are generated by tools/keytab.py.
*======================================================================

* KINIT - the keyboard as at power-up: no chord down, nothing buffered.
* The kernel calls it once at boot.  Leaf.  Uses nothing.
KINIT  CLR  @JOY1
       CLR  @JOY2
       CLR  @JOYN1
       CLR  @JOYN2
       CLR  @JKLAST
       CLR  @JKHOLD
       CLR  @KHEAD
       CLR  @KTAIL
       CLR  @KLAST
       CLR  @KHOLD
       CLR  @KCOUNT
       SETO @KLKEY
       SETO @KCURK
       RT


* KSCAN - read the six keyboard columns into KEYMAP (0 bit = pressed;
* row r is bit r of a column's byte), then ALPHA LOCK into ALOCK.
* Output 21 is held high while scanning so ALPHA LOCK stays off input 7
* (FCTN's row).  ALPHA LOCK is then read with column 0 selected and
* output 21 low; input 7 low means down, unless FCTN is held, whose key
* pulls the same line: then the last state is kept.  Leaf.  Uses R1-R4, R12.
KSCAN  CLR  R12
       SBO  21                 ALPHA LOCK off the row lines while scanning
       LI   R2,KEYMAP          6 output bytes, one per column
       CLR  R1                 column number in the high byte
       LI   R3,6
KSC1   LI   R12,>0024          CRU outputs 18-20 select the column
       LDCR R1,3
       NOP                     settle time for the 9901 outputs
       NOP
       LI   R12,>0006          CRU inputs 3-10 are the row lines
       CLR  R4
       STCR R4,8               row bits -> high byte, input 3 -> bit 0
       MOVB R4,*R2+            store: 0 bit = key down
       AI   R1,>0100
       DEC  R3
       JNE  KSC1
       LI   R12,>0024          column 0 for ALPHA LOCK
       CLR  R1
       LDCR R1,3
       CLR  R12
       SBZ  21                 ALPHA LOCK onto input 7
       NOP
       TB   7                  EQ = input high = not down
       SBO  21
       JEQ  KSA1
       MOVB @KEYMAP,R4         low: ALPHA LOCK down, or FCTN held
       ANDI R4,>1000           FCTN is row 4 of column 0 (0 = down)
       JEQ  KSA9               FCTN held: cannot tell, keep the last state
       LI   R4,1
       MOV  R4,@ALOCK
       RT
KSA1   CLR  @ALOCK
KSA9   RT

* KDECOD - the chord in KEYMAP: R0 = its code in the high byte, or 0 for
* no key (or a chord with no code); R1 = modifier flags in the high byte
* (>80 FCTN, >40 SHIFT, >20 CTRL, >10 ALPHA LOCK).  The first key found,
* column by column, wins.  FCTN takes precedence over CTRL over SHIFT.
* ALPHA LOCK capitalises letters typed with no modifier.  Leaf.  Uses
* R0-R7.
KDECOD MOVB @KEYMAP,R4         column 0: = SPACE ENTER and the modifiers
       INV  R4                 1 = pressed
       ANDI R4,>FF00
       CLR  R1
       LI   R2,KTABN
       MOV  R4,R5
       ANDI R5,>2000           SHIFT (row 5)
       JEQ  KD1
       LI   R2,KTABS
       ORI  R1,>4000
KD1    MOV  R4,R5
       ANDI R5,>4000           CTRL (row 6)
       JEQ  KD2
       LI   R2,KTABC
       ORI  R1,>2000
KD2    MOV  R4,R5
       ANDI R5,>1000           FCTN (row 4)
       JEQ  KD3
       LI   R2,KTABF
       ORI  R1,>8000
KD3    MOV  @ALOCK,R5
       JEQ  KD4
       ORI  R1,>1000
KD4    ANDI R4,>0700           column 0: only rows 0-2 are keys
       LI   R3,KEYMAP+1        the next column's byte
       CLR  R6                 column * 8
       LI   R7,5               columns still to look at
KD5    MOV  R4,R4
       JNE  KD6                something pressed in this column
       MOV  R7,R7
       JEQ  KDNONE             none left: no key
       DEC  R7
       MOVB *R3+,R4
       INV  R4
       ANDI R4,>FF00
       AI   R6,8
       JMP  KD5
KD6    SRL  R4,8               bit r of the low byte = row r
KD7    SRL  R4,1               the lowest row pressed ...
       JOC  KD8
       INC  R6
       JMP  KD7
KD8    MOV  R6,@KCURK          (the key itself, whatever its code)
       A    R6,R2              ... gives the table entry
       CLR  R0
       MOVB *R2,R0
       JEQ  KD9
       MOV  R1,R5              ALPHA LOCK: capitals, with no modifier only
       ANDI R5,>E000
       JNE  KDX
       MOV  @ALOCK,R5
       JEQ  KDX
       CI   R0,>6100           'a'
       JL   KDX
       CI   R0,>7A00           'z'
       JH   KDX
       AI   R0,->2000
KDX    RT
KD9    CLR  R0                 a chord with no code
       RT
KDNONE SETO @KCURK             no key at all
       CLR  R0
       RT

* KPOLL - scan, decode, and buffer a code when a key goes down, and on
* each repeat while it is held.  A code comes from the key and the
* modifiers held as it went down; letting go of a modifier before the key
* (or pressing one late) changes nothing while that key stays down, so
* releasing CTRL a moment before B never types a stray 'b'.  Repeats
* send the key's first code.  Uses R0-R7, R12.
KPOLL  .enter
       BL   @KSCAN
       BL   @JOYPOLL           the joysticks, from the same matrix
       BL   @KDECOD
       MOV  @KCURK,R2
       JLT  KP0                no key down
       C    R2,@KLKEY
       JEQ  KP2                the same key still down: held
       MOV  R2,@KLKEY          a new key: its code now
       MOV  R0,@KLAST
       CLR  @KHOLD
       MOV  R0,R0
       JEQ  KP9                (a chord with no code: nothing to send)
       JMP  KP3
KP0    SETO @KLKEY             no key: nothing held
       CLR  @KLAST
       CLR  @KHOLD
       JMP  KP9
KP2    MOV  @KLAST,R0          held: repeat at 24 frames, then every 4
       JEQ  KP9                nothing held?
       INC  @KHOLD             one more frame held
       MOV  @KHOLD,R2
       CI   R2,24              24 frames yet?
       JL   KP9
       LI   R2,20              then repeat every 4 (24 - 20)
       MOV  R2,@KHOLD
KP3    MOV  R1,@KMODS
       BL   @KPUT              the code into the buffer
KP9    .leave
       RT

* JOYPOLL - read both joysticks (keyboard columns 6 and 7; the rows are fire,
* left, right, down, up, 0 = active) into JOY1 and JOY2 as JFIRE|JLEFT|JRIGHT|
* JDOWN|JUP (1 = active), noting presses in JOYN1 and JOYN2; and, if JOYKEY says
* so, type arrow-key and ENTER codes for them with the keyboard's repeat.  Uses
* R0-R6, R12.
JOYPOLL .enter
       LI   R1,>0600
       LI   R5,JOY1
       BL   @JOYRD
       LI   R1,>0700
       LI   R5,JOY2
       BL   @JOYRD
       MOV  @JOYKEY,R0
       JEQ  JP9
       CLR  R4                 the joysticks the flag names, together
       MOV  @JOYKEY,R0
       ANDI R0,1
       JEQ  JK1
       SOC  @JOY1,R4
JK1    MOV  @JOYKEY,R0
       ANDI R0,2
       JEQ  JK2
       SOC  @JOY2,R4
JK2    LI   R3,JKTAB           the first direction in the table that is down
JK3    MOV  *R3+,R2
       JEQ  JKNO
       COC  R2,R4
       JEQ  JKYES
       INCT R3
       JMP  JK3
JKYES  MOV  *R3,R0
       JMP  JK6
JKNO   CLR  R0
JK6    C    R0,@JKLAST
       JEQ  JK7
       MOV  R0,@JKLAST         a new code: type it
       CLR  @JKHOLD
       MOV  R0,R0
       JEQ  JP9
       BL   @KPUT
       JMP  JP9
JK7    MOV  R0,R0              the same code still held: repeat it as a key does
       JEQ  JP9
       INC  @JKHOLD
       MOV  @JKHOLD,R2
       CI   R2,24
       JL   JP9
       LI   R2,20
       MOV  R2,@JKHOLD
       BL   @KPUT
JP9    .leave
       RT
JKTAB  DATA JUP,KUP*256,JDOWN,KDOWN*256,JLEFT,KLEFT*256,JRIGHT,KRIGHT*256
       DATA JFIRE,KENTER*256,0

* JOYRD - R1 = a column in the high byte (>0600 joystick 1, >0700 joystick 2),
* R5 = JOY1 or JOY2: the state word at R5 gets what is down now, and the presses
* that are new join the word four bytes on (JOYN1, JOYN2). Leaf. Uses R1-R6,
* R12.
JOYRD  LI   R12,>0024          CRU outputs 18-20 select the column
       LDCR R1,3
       NOP
       NOP
       LI   R12,>0006          the row lines
       CLR  R4
       STCR R4,8
       INV  R4                 1 = active
       ANDI R4,>1F00           fire, left, right, down, up
       SRL  R4,8
       MOV  R4,R6
       SZC  *R5,R6             down now and not before: new
       MOV  R5,R2
       AI   R2,4
       SOC  R6,*R2
       MOV  R4,*R5
       RT

* JOYGET - joystick R0 (1 or 2): R1 = what is down now
* (JFIRE|JLEFT|JRIGHT|JDOWN|
* JUP), R2 = what went down since the last JOYGET (cleared by this call), so a
* program sees every press however brief.  Any other R0: R1 = R2 = 0.  The state
* is read once a frame, by KPOLL, so it follows the main loop (and KIDLE).
* Leaf.
* Uses R1, R2.
JOYGET CI   R0,1
       JEQ  JG1
       CI   R0,2
       JEQ  JG2
       CLR  R1
       CLR  R2
       RT
JG1    MOV  @JOY1,R1
       MOV  @JOYN1,R2
       CLR  @JOYN1
       RT
JG2    MOV  @JOY2,R1
       MOV  @JOYN2,R2
       CLR  @JOYN2
       RT

* KPUT - put code R0 (high byte) in the buffer; dropped if it is full.
* A key restarts the console's screen-blank timer and turns the display
* back on, should the console have blanked it: VR1 = VR1CPY with the
* display bit set, so the current mode is kept (Text 80 in the editor,
* Graphics II on the title).  Leaf.  Uses R2, R3.
KPUT   MOV  @KHEAD,R2
       MOV  R2,R3
       INC  R3
       ANDI R3,63
       C    R3,@KTAIL
       JEQ  KPU9               full
       MOVB R0,@KBUF(R2)
       MOV  R3,@KHEAD
       CLR  @SCRTMO
       MOVB @VR1CPY,R2         VR1 = the console's copy (the current mode)
       ORI  R2,>4000           with the display on: data byte first,
       MOVB R2,@VDPWA          then >80|1
       LI   R2,>8100
       MOVB R2,@VDPWA
KPU9   RT

* KEYGET - the next code from the buffer: R0 (high byte), or 0.  Leaf.
* Uses R0, R2.
KEYGET CLR  R0
       MOV  @KTAIL,R2          the buffer's tail
       C    R2,@KHEAD          empty (tail = head)?
       JEQ  KGT9
       MOVB @KBUF(R2),R0       the next code
       INC  R2                 the next slot
       ANDI R2,63              (round the 64)
       MOV  R2,@KTAIL
       INC  @KCOUNT            codes taken (for the tests)
KGT9   RT

* KFLUSH - throw away every buffered code (a key held down will repeat
* again).  Leaf.  Uses nothing.
KFLUSH MOV  @KHEAD,@KTAIL
       RT

* KIDLE - poll the keyboard if a frame has passed (the VDP's frame flag),
* so keys typed during long work are buffered, and steps the music player.
* Reading the flag clears it, so the console's interrupt does not fire in a
* LIMI 0 section.  Call only between VDP transfers.  Uses R0-R8, R12.
KIDLE  .enter
       MOVB @VDPSTA,R0         the VDP's status: bit 0 is the frame flag
       ANDI R0,>8000
       JEQ  KI9
       INC  @FRAME             count the frame
       BL   @KPOLL             and take any keys
       BL   @MUTICK            and step the song
KI9    .leave
       RT

* KPFR - a frame has passed during a long byte loop (the caller read the
* VDP status, saw bit 7 and thereby cleared it): poll the keyboard, every
* register but R0 kept.  Use it inside tight loops that cannot afford
* KIDLE's own register use.
KPFR   .enter
       .push R1
       .push R2
       .push R3
       .push R4
       .push R5
       .push R6
       .push R7
       .push R8
       INC  @FRAME             count the frame
       BL   @KPOLL             and take any keys
       BL   @MUTICK            and step the song
       .pop R8
       .pop R7
       .pop R6
       .pop R5
       .pop R4
       .pop R3
       .pop R2
       .pop R1
       .leave
       RT

* KWAIT - wait for a key: R0 = its code (high byte).  Runs frames
* (VSYNC, KPOLL) until one arrives, so it is for modal moments only
* (a message that waits for a key, a prompt): the module's TICK does not
* run meanwhile.  Uses R0-R8, R12.
KWAIT  .enter
KW1    BL   @VSYNC
       BL   @MUTICK
       BL   @KPOLL
       BL   @KEYGET
       MOV  R0,R0
       JEQ  KW1
       .leave
       RT

       COPY "keytab.a99"
       EVEN
