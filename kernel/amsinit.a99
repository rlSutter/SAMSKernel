*======================================================================
* amsinit.a99 - the memory card found, sized and tested (the loader only: the
* kernel
* keeps pager.a99's mapping routines)
*======================================================================

* AMSDET - detect a mapper.  Must be called in pass-through mode
* (before AMSINI).  Returns R0 = 1 if present, 0 if not.
* Uses R1-R3, R12.
AMSDET LI   R12,AMSCRU
       SBO  0                  expose registers at >4000
       MOV  @AMSREG+4,R1       save window-2 register
       LI   R2,>1515           arbitrary probe value, same in both bytes
       MOV  R2,@AMSREG+4
       NOP                     let the bus settle before reading back
       MOV  @AMSREG+4,R3
       MOV  R1,@AMSREG+4       restore
       SBZ  0                  registers hidden again
       CLR  R0
       CB   R2,R3              compare the byte the register latched
       JNE  AMSD1
       INC  R0
AMSD1  RT

* AMSINI - identity-map all 16 windows and switch mapping mode on.
* After this, page n is at address n<<12 for n = 0..15, which means
* the kernel at >A000 is on pages >A->D and nothing moved.
* Uses R1-R3, R12.
AMSINI LI   R12,AMSCRU         CRU base for the mapper card
       SBO  0                  registers visible
       CLR  R1                 window 0
       LI   R3,AMSREG          register for window 0
AMSI1  MOV  R1,R2              identity: window n gets page n, in the high
       SLA  R2,8               byte only (see MAPPG): with mapping off the
* card puts page n in window n, so this code runs on
       MOV   R2,*R3+
       INC  R1
       CI   R1,16
       JL   AMSI1
       SBO  1                  mapping mode on
       SBZ  0                  hide registers (they share DSR space)
       LI   R0,PGLOWA*256+PGLOWA+1
       MOV  R0,@CURPA
       LI   R0,PGLOWB*256+PGLOWB+1
       MOV  R0,@CURPB
       RT

* PAGEA - map pages R0 and R0+1 into slot A (>2000, >3000).
PAGEA  .enter
       MOV  R0,R4              first page ...
       SLA  R4,8               ... in the high byte
       MOV  R0,R7              second page = first + 1
       INC  R7
       SOC  R7,R4              R4 = (p<<8)|(p+1)
       MOV  R4,@CURPA          remember what slot A holds
       LI   R1,2               window >2000
       BL   @MAPPG
       MOV  R7,R0
       LI   R1,3               window >3000
       BL   @MAPPG
       .leave
       RT

* AMSSIZ - how many pages the card has: R0 = 32, 64, 128 or 256 (256
* meaning 1M or more; larger cards are used as 1M for now).  Writes a
* marker to page >10 and checks whether a write to page >10+32, +64 or
* +128 lands on it (the card decodes only as many page bits as it has).
* Run after AMSINI and before anything is loaded: it overwrites the first
* word of pages >10, >30, >50 and >90.  Leaf apart from MAPPG (R11 kept
* in R6).  Uses R0-R6, R12.
AMSSIZ MOV  R11,R6             MAPPG is called: keep the return address
       LI   R5,32              alias distance to try first
AZ1    LI   R0,>10             the reference page ...
       LI   R1,>E              ... into window >E000
       BL   @MAPPG
       LI   R4,>A55A
       MOV  R4,@>E000          its marker
       MOV  R5,R0              the page S above it
       AI   R0,>10
       LI   R1,>E
       BL   @MAPPG
       MOV  R5,@>E000          a different marker there
       LI   R0,>10             the reference page again
       LI   R1,>E
       BL   @MAPPG
       C    @>E000,R4          still its own marker?
       JNE  AZ2                no: page >10+S is page >10, so S pages exist
       SLA  R5,1               yes: try twice the distance
       CI   R5,256
       JL   AZ1
AZ2    LI   R0,PGLOWB          window >E000 back to its own page
       LI   R1,>E
       BL   @MAPPG
       MOV  R5,R0              32, 64, 128, or 256 when nothing aliased
       B    *R6

* AMSTST - write a page-specific word to the first and last word of every
* page from >10 up to R0-1, then check them all.  Pages below >10 are
* skipped (slot A, the kernel's pages and slot B's default pair).  Run
* by the loader before loading: it is destructive.  Returns R0 = 0 if
* every page answered, else the first failing page.  R11 kept in R6;
* uses R0-R7, R12.
AMSTST MOV  R11,R6
       MOV  R0,R7              page limit
       LI   R5,>10             from page >10
AT1    MOV  R5,R0
       LI   R1,>E              window >E000
       BL   @MAPPG             the page there
       MOV  R5,R4              signature: page number and its complement
       SWPB R4
       XOR  R5,R4
* page-specific: its number mixed with its complement
       INV   R4
       MOV  R4,@>E000          at the page's first word ...
       MOV  R4,@>EFFE          ... and its last
       INC  R5                 the next page
       C    R5,R7              all of them?
       JL   AT1
       LI   R5,>10             then read them all back
AT2    MOV  R5,R0
       LI   R1,>E              window >E000
       BL   @MAPPG             the page there
       MOV  R5,R4
       SWPB R4
       XOR  R5,R4
       INV  R4
       C    @>E000,R4          its first word right?
       JNE  AT3
       C    @>EFFE,R4          and its last?
       JNE  AT3
       INC  R5                 the next page
       C    R5,R7              all of them?
       JL   AT2
       CLR  R5                 all answered
AT3    LI   R0,PGLOWB
       LI   R1,>E
       BL   @MAPPG
       MOV  R5,R0
       B    *R6
