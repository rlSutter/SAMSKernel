*======================================================================
* pager.a99 - AMS / SAMS page manager (from The Lantern Coast)
*
* Windows are numbered by address nibble: window 2 = >2000, window >E
* = >E000.  The fixed kernel windows >A->D are mapped once at boot and
* never touched again.  Slot A = windows 2,3; slot B = windows >E,>F;
* slot C = windows >C,>D.
*
* Rule: code that calls MAPPG/PAGEA/PAGEB/PAGEC must not itself live in
* the window it is remapping.  Module code (slot C) may page slot B; only
* the kernel's main loop remaps slot C (a module asks with GOMOD, or
* calls another with MODCALL, which are the kernel's); nothing remaps
* slot A (the stack lives there).
*
* A page is a number 0-4095 (a SAMS card of up to 16M).  CURA2/CURA3,
* CURBE/CURBF and CURCC/CURCD record the page each window of the slots holds.
* Every routine here keeps them in step, so code that borrows slot B (LDSCHM,
* a library routine) can save the pages with GETPB and put them back with
* SETPB.  Never write a mapper register by any other route.
*======================================================================

* PAGEC - map pages R0 and R0+1 into slot C (>C000, >D000): a module.
* Recorded in CURCC/CURCD.  Kernel use only (see above).  Uses R0-R3, R7, R12.
PAGEC  .enter
       MOV  R0,@CURCC
       MOV  R0,R7
       INC  R7
       MOV  R7,@CURCD
       LI   R1,>C              window >C000
       BL   @MAPPG
       MOV  R7,R0
       LI   R1,>D              window >D000
       BL   @MAPPG
       .leave
       RT

* MAPPG - map one page into one window.
*   R0 = page (0-4095), R1 = window (0-15)
* Uses R2, R3, R12.  Leaf.  Does not update the tracking words: use it for
* windows you track yourself; PAGEB, MAPE and MAPF track slot B.
* The register takes the page's low 8 bits in the even byte and bits 8-11 in
* the odd byte (a card of 1M or less ignores the odd byte): the page with its
* bytes swapped.
MAPPG  MOV  R0,R2
       SWPB R2
       MOV  R1,R3              window number ...
       SLA  R3,1               ... times two = register offset
       AI   R3,AMSREG          register address
       LI   R12,AMSCRU
       SBO  0
       MOV  R2,*R3             write the page
       SBZ  0
       RT

* PAGEB - map pages R0 and R0+1 into slot B (>E000, >F000), recorded in
* CURBE/CURBF.  Uses R0-R3, R7, R12.
PAGEB  .enter
       MOV  R0,@CURBE
       MOV  R0,R7
       INC  R7
       MOV  R7,@CURBF
       LI   R1,>E              window >E000
       BL   @MAPPG
       MOV  R7,R0
       LI   R1,>F              window >F000
       BL   @MAPPG
       .leave
       RT

* MAPE / MAPF - map page R0 into window >E000 / >F000 alone, unless it is
* there already; recorded in CURBE / CURBF.  Leaves.  Use R1-R3, R12 (nothing,
* when the page is already mapped).
MAPE   C    R0,@CURBE           already in >E000?
       JEQ  MAP9
       MOV  R0,@CURBE
       LI   R1,>E
       B    @MAPPG             (MAPPG returns for us)
MAPF   C    R0,@CURBF           already in >F000?
       JEQ  MAP9
       MOV  R0,@CURBF
       LI   R1,>F
       B    @MAPPG
MAP9   RT

* GETPB - the pages slot B holds now: R0 = the page in >E000, R1 = the page in
* >F000.  Save them to put slot B back later with SETPB.  Leaf.
GETPB  MOV  @CURBE,R0
       MOV  @CURBF,R1
       RT

* SETPB - put slot B back as it was: R0 = the page for >E000, R1 = the page
* for >F000 (what GETPB gave; the two pages need not be consecutive).  Uses
* R0-R4, R12.
SETPB  .enter
       MOV  R0,@CURBE
       MOV  R1,@CURBF
       MOV  R1,R4
       LI   R1,>E
       BL   @MAPPG
       MOV  R4,R0
       LI   R1,>F
       BL   @MAPPG
       .leave
       RT
