*======================================================================
* text.a99 - writing text on the screen (Text 80, Text 40, Graphics I)
*
* A screen position is row * columns + column.  Each cell has a name-table
* byte (the glyph) and, in the modes that have one, an attribute byte
* (foreground role << 4 | background role).  Attributes are passed in the
* high byte.
*======================================================================
* THE TEXT SCREEN.  In the text modes the screen is a grid of cells.  Each
* cell has a byte in the NAME TABLE (which glyph to draw) and, in the modes
* with per-cell colour, a byte in the ATTRIBUTE TABLE (which colours).  Both
* tables live in VRAM, so every routine here ends in a VRAM write (VMBW,
* VFILL, VSBW).  A POSITION is a number, row * columns + column, counting from
* 0 at the top left: the same number indexes both tables.  NAMBAS and ATRTAB
* are the tables' VRAM addresses, and TXCOLS, TXROWS, TXATTR (non-zero when
* the mode has an attribute table) describe the current mode; VMODE sets them
* all.  So these routines work unchanged in Text 80, Text 40 and Graphics I.
*
* Arguments follow one convention throughout: a position in R0, a string
* address in R1, an attribute in R2 (in the HIGH byte, like every byte
* argument on this CPU).  The attribute holds two ROLE numbers (foreground in
* the high nibble, background in the low) which the colour scheme turns into
* colours; see kdefs.a99, 'Colour roles'.  Each routine's header lists the
* registers it changes: callers rely on that list.

* The text routines follow the video mode (VMODE sets TXCOLS, TXROWS,
* TXCELLS, TXATTR, NAMBAS): a position is row * TXCOLS + column, and in a
* mode with no attribute table (Graphics I without ECM, Text with the colours
* of VR7) the attribute is ignored.  In the enhanced colour modes the
* "attribute" is the ECM attribute byte (docs/VIDEO-MODES.md).  They are for
* the modes whose names are glyphs: Text 80, Text 40 and Graphics I.

* PUTS is the routine most programs call most.  A string is a length byte
* followed by the characters (what STRI assembles); PUTS writes the glyphs to
* the name table with one block write, then paints the same cells' attributes
* with one fill, so a string costs two VRAM transfers however long it is.
* PUTS - length-prefixed string at R1 to position R0, attribute R2.
* Uses R0-R7.
PUTS   .enter
       MOV  R2,R5              attribute
       MOV  R0,R6              position
       CLR  R2
       MOVB *R1+,R2
       SWPB R2                 length
       JEQ  PS9
       MOV  R2,R7
       A    @NAMBAS,R0
       BL   @VMBW              the glyphs
       MOV  @TXATTR,@TXATTR    a mode with no attribute table: done
       JEQ  PS9
       MOV  R6,R0
       AI   R0,ATRTAB
       MOV  R5,R1
       MOV  R7,R2
       BL   @VFILL             their attributes
PS9    .leave
       RT

* FILLA - attribute R1 (high byte) over R2 cells from position R0.
* FILLN - glyph R1 (high byte) over R2 cells from position R0.  Leaves.
FILLA  MOV  @TXATTR,@TXATTR    a mode with no attribute table: nothing to do
       JNE  FLA1
       RT
FLA1   AI   R0,ATRTAB
       B    @VFILL
FILLN  A    @NAMBAS,R0
       B    @VFILL

* How a number becomes digits: the classic divide-by-ten loop.  DIV R7,R4
* divides the 32-bit number R4:R5 by R7 (here 10): the quotient goes to R4 and
* the remainder, 0 to 9, to R5; adding >30 makes it the ASCII digit.  Digits
* come out last-first, so they are stored backwards from the end of a small
* buffer (TXBUF) and a length byte is put in front, which makes the result an
* ordinary length-prefixed string for PUTS.  The loop ends when the quotient
* reaches 0, so a number never has leading zeros (and zero itself prints as
* '0').
* DECW - R1 as an unsigned decimal number at R0, attribute R2, no leading
* zeros.  Returns R3 = the number of digits.  Uses R0-R8.
DECW   .enter
       MOV  R0,R6
       MOV  R2,R8
       LI   R3,TXTBUF+6        digits are built backwards from here
       MOV  R1,R5
DW1    CLR  R4                 R4:R5 / 10
       LI   R7,10
       DIV  R7,R4              R4 = quotient, R5 = remainder
       AI   R5,>30
       SWPB R5
       MOVB R5,*R3
       DEC  R3
       MOV  R4,R5
       JNE  DW1
       LI   R1,TXTBUF+6        length = digits written
       S    R3,R1
       MOV  R1,R4
       SWPB R1
       MOVB R1,*R3             the length byte just before the digits
       MOV  R3,R1
       MOV  R6,R0
       MOV  R8,R2
       .push R4
       BL   @PUTS
       .pop R3
       .leave
       RT

* PUTC - glyph R1 (high byte) at position R0 with attribute R2.
* Uses R0-R2, R6.
PUTC   .enter
       MOV  R0,R6
       A    @NAMBAS,R0
       BL   @VSBW
       MOV  @TXATTR,@TXATTR
       JEQ  PC9
       MOV  R6,R0
       AI   R0,ATRTAB
       MOV  R2,R1
       BL   @VSBW
PC9    .leave
       RT

* HEX2 - the low byte of R1 as two hex digits at R0, attribute R2.
* Uses R0-R7.
HEX2   .enter
       LI   R3,TXTBUF
       LI   R4,>0200           length 2
       MOVB R4,*R3+
       MOV  R1,R4
       SRL  R4,4
       BL   @HEXD
       MOV  R1,R4
       BL   @HEXD
       LI   R1,TXTBUF
       BL   @PUTS
       .leave
       RT
* HEXD - the low nibble of R4 as a hex digit at *R3+ (R3 moves on one).
* Leaf.  Uses R3, R4.
HEXD   ANDI R4,>000F
       AI   R4,>30
       CI   R4,>3A
       JL   HXD1
       AI   R4,7               A-F
HXD1   SWPB R4
       MOVB R4,*R3+
       RT

* HEX4 - the word R1 as four hex digits at R0, attribute R2.  Uses R0-R7.
HEX4   .enter
       LI   R3,TXTBUF
       LI   R4,>0400           length 4
       MOVB R4,*R3+
       MOV  R1,R4
       SRL  R4,12
       BL   @HEXD
       MOV  R1,R4
       SRL  R4,8
       BL   @HEXD
       MOV  R1,R4
       SRL  R4,4
       BL   @HEXD
       MOV  R1,R4
       BL   @HEXD
       LI   R1,TXTBUF
       BL   @PUTS
       .leave
       RT

* CLS - clear the screen: every glyph a space and (where the mode has an
* attribute table) every attribute R1 (high byte; usually
* (RTEXT*16+RBG)*256).  Uses R0-R2.
CLS    .enter
       MOV  R1,R2
       .push R2
       MOV  @NAMBAS,R0
       LI   R1,>2000
       MOV  @TXCELLS,R2
       BL   @VFILL
       .pop R1
       MOV  @TXATTR,@TXATTR
       JEQ  CLS9
       LI   R0,ATRTAB
       MOV  @TXCELLS,R2
       BL   @VFILL
CLS9   .leave
       RT

* BOX - a single-line frame in glyphs 1-6 (the UI glyphs: docs/GLYPHS.md):
* R0 = the top-left cell's position (row * columns + column), R1 = interior
* width, R2 = interior height, R3 = attribute (high byte).  The interior
* is left alone.  Uses R0-R9.
BOX    .enter
       MOV  R0,R4              top-left cell
       MOV  R1,R5              interior width
       MOV  R2,R6              interior height
       MOV  R3,R7              attribute
       MOV  R4,R0              the top edge: corner, run, corner
       LI   R1,>0300
       BL   @BXCEL
       MOV  R4,R0
       INC  R0
       LI   R1,>0100
       MOV  R5,R2
       BL   @BXRUN
       MOV  R4,R0
       A    R5,R0
       INC  R0
       LI   R1,>0400
       BL   @BXCEL
       MOV  R6,R8              the sides: R8 rows left, R9 the row's first cell
       MOV  R4,R9
BX2    MOV  R8,R8
       JEQ  BX3
       A    @TXCOLS,R9
       MOV  R9,R0
       LI   R1,>0200
       BL   @BXCEL
       MOV  R9,R0
       A    R5,R0
       INC  R0
       LI   R1,>0200
       BL   @BXCEL
       DEC  R8
       JMP  BX2
BX3    MOV  R6,R0              the bottom edge: top + (height + 1) * columns
       INC  R0
       MOV  @TXCOLS,R1
       MPY  R1,R0              R0:R1 = the product
       A    R4,R1
       MOV  R1,R9
       MOV  R9,R0
       LI   R1,>0500
       BL   @BXCEL
       MOV  R9,R0
       INC  R0
       LI   R1,>0100
       MOV  R5,R2
       BL   @BXRUN
       MOV  R9,R0
       A    R5,R0
       INC  R0
       LI   R1,>0600
       BL   @BXCEL
       .leave
       RT
* BXCEL - one cell; BXRUN - R2 cells: glyph R1 (high byte) from position
* R0, attribute R7.  Use R0-R2.
BXCEL  LI   R2,1
BXRUN  .enter
       MOV  R2,R2
       JEQ  BXR9
       .push R0
       .push R2
       BL   @FILLN
       .pop R2
       .pop R0
       MOV  R7,R1
       BL   @FILLA
BXR9   .leave
       RT

* DECD - the unsigned 32-bit number R1:R2 (high word, low word) as a decimal
* number at position R0, attribute R3, at least R4 characters wide (0: as wide
* as it is; padded with spaces on the left, so that numbers line up; at most
* 11).
* The digits come out of two divisions by ten: the high word first (its
* remainder is the high half of the next dividend), then that and the low word.
* R3 = the number of characters written.  Uses R0-R8.
DECD   .enter
       .push R0
       .push R3
       .push R4
       LI   R6,TXTBUF+11       the digits are built backwards from here
       LI   R7,10
DD1    CLR  R4                 divide the high word by ten ...
       MOV  R1,R5
       DIV  R7,R4              R4 = its quotient, R5 = the remainder
       MOV  R4,R1
       MOV  R5,R4              ... then (that remainder : the low word) by ten
       MOV  R2,R5
       DIV  R7,R4              R4 = the new low word, R5 = the digit
       MOV  R4,R2
       AI   R5,>30
       SWPB R5
       MOVB R5,*R6
       DEC  R6
       MOV  R1,R4
       SOC  R2,R4              both words zero?
       JNE  DD1
       LI   R1,TXTBUF+11       R1 = the digits written
       S    R6,R1
       .pop R0                 the width asked for
       CI   R0,11
       JLE  DD2
       LI   R0,11
DD2    LI   R5,>2000
DD2A   C    R1,R0              pad with spaces up to it
       JHE  DD3
       MOVB R5,*R6
       DEC  R6
       INC  R1
       JMP  DD2A
DD3    MOV  R1,R5              the length byte before it all
       SWPB R5
       MOVB R5,*R6
       .pop R2                 the attribute
       .pop R0                 the position
       .push R1                (the length: the result)
       MOV  R6,R1
       BL   @PUTS
       .pop R3
       .leave
       RT

* YESNO - ask a question: the prompt at R1 (length-prefixed) is written at
* position R0 with attribute R2, followed by ' (Y/N)'; then it waits (KWAIT) for
* Y or N.  R0 = 1 for Y, 0 for N or BACK (FCTN 9).  Any other key is ignored.
* The line is left as it is: the caller redraws it.  Uses R0-R8, R12.
YESNO  .enter
       .push R0
       .push R1
       .push R2
       BL   @PUTS
       .pop R2
       .pop R1
       .pop R0
       CLR  R3                 the suffix goes right after the prompt
       MOVB *R1,R3
       SWPB R3
       A    R3,R0
       LI   R1,YNSUF
       BL   @PUTS
YN1    BL   @KWAIT
       CI   R0,>6100           letters to capitals
       JL   YN2
       CI   R0,>7A00
       JH   YN2
       AI   R0,->2000
YN2    CI   R0,>5900           Y
       JEQ  YN3
       CI   R0,>4E00           N
       JEQ  YN4
       CI   R0,KBACK*256
       JNE  YN1
YN4    CLR  R0
       JMP  YN9
YN3    LI   R0,1
YN9    .leave
       RT
YNSUF  STRI ' (Y/N)'
       EVEN

* PRESSK - the prompt at R1 (length-prefixed) at position R0, attribute R2, then
* wait for any key (KWAIT): R0 = its code.  Uses R0-R8, R12.
PRESSK .enter
       BL   @PUTS
       BL   @KWAIT
       .leave
       RT
